.\n              </p>\n            </div>\n\n            {/* Controls: Segmented Tier Filters & Sort */}\n            <div className=\"flex flex-wrap items-center gap-3\">\n              {/* Category Segmented Tabs */}\n              <div className=\"flex items-center p-1 bg-slate-100 rounded-lg text-xs font-medium\">\n                <button\n                  onClick={() => setTierFilter(\'all\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'all\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Todos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'economico\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'economico\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Econ\303\264micos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'intermediario\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'intermediario\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Intermedi\303\241rios\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'premium\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'premium\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Premium\n                </button>\n              </div>\n\n              {/* Sort Dropdown */}\n              <div className=\"flex items-center gap-1.5 text-xs text-slate-600\">\n                <ArrowUpDown className=\"w-3.5 h-3.5 text-slate-400\" />\n                <select\n                  value={sortBy}\n                  onChange={(e) => setSortBy(e.target.value as any)}\n                  className=\"px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 font-medium\"\n                >\n                  <option value=\"price_asc\">Menor Pre\303\247o Mensal</option>\n                  <option value=\"price_desc\">Maior Pre\303\247o Mensal</option>\n                  <option value=\"ans_score\">Maior Nota ANS (IDSS)</option>\n                  <option value=\"reimbursement\">Maior Reembolso</option>\n                </select>\n              </div>\n            </div>\n          </div>"
