    content: "import React, { useState } from \'react\';\nimport { X, Copy, Check, MessageSquare, Printer, FileText, Send, Building } from \'lucide-react\';\nimport { CalculatedPlanQuote, QuoteInput } from \'../types/healthPlan\';\nimport { getAnsAgeBracketLabel } from \'../utils/pricingEngine\';\n\ninterface ExportSummaryModalProps {\n  quote: CalculatedPlanQuote | null;\n  input: QuoteInput;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const ExportSummaryModal: React.FC<ExportSummaryModalProps> = ({\n  quote,\n  input,\n  isOpen,\n  onClose,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [leadName, setLeadName] = useState(\'\');\n  const [leadEmail, setLeadEmail] = useState(\'\');\n  const [leadPhone, setLeadPhone] = useState(\'\');\n  const [submitted, setSubmitted] = useState(false);\n\n  if (!isOpen || !quote) return null;\n\n  const generateTextSummary = () => {\n    return `*COTA\303\207\303\203O ESTIMADA DE PLANO DE SA\303\232DE - COMPARA SA\303\232DE BRASIL*\n------------------------------------------------\n*Plano:* ${quote.planName} (${quote.operatorName})\n*Registro ANS:* ${quote.ansRegister} \302\267 *\303\215ndice IDSS:* ${quote.ansScore.toFixed(2)}\n*Modalidade:* ${input.contractType.toUpperCase()} | *Acomoda\303\247\303\243o:* ${quote.accommodation.toUpperCase()}\n*Coparticipa\303\247\303\243o:* ${quote.copay === \'com_coparticipacao\' ? \'SIM\' : \'N\303\203O\'}\n*Abrang\303\252ncia:* ${quote.coverageArea.toUpperCase()} | *UF:* ${input.state}\n\n*ESTIMATIVA TOTAL MENSAL:* R$ ${quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')} / m\303\252s\n(Intervalo de mercado: R$ ${quote.priceRangeMin} a R$ ${quote.priceRangeMax})\n\n*Detalhamento por Vida (${quote.perBeneficiaryBreakdown.length} vidas):*\n${quote.perBeneficiaryBreakdown\n  .map(\n    (b) =>\n      `- ${b.beneficiaryName}: ${b.age} anos (${getAnsAgeBracketLabel(b.ageBracket)}) -> R$ ${b.calculatedPrice.toLocaleString(\'pt-BR\')}`\n  )\n  .join(\'\\n\')}\n\n*Car\303\252ncias ANS B\303\241sicas:*\n- Urg\303\252ncia/Emerg\303\252ncia: 24h\n- Consultas e Exames: 30 dias\n- Cirurgias e Interna\303\247\303\265es: 180 dias\n- Parto: 300 dias\n\n*Principais Hospitais:*\n${quote.hospitals.slice(0, 5).map((h) => `\342\200\242 ${h}`).join(\'\\n\')}\n------------------------------------------------\n_Gerado via ComparaSa\303\272de Brasil em ${new Date().toLocaleDateString(\'pt-BR\')}_`;\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(generateTextSummary());\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2500);\n  };\n\n  const handleWhatsApp = () => {\n    const text = encodeURIComponent(generateTextSummary());\n    window.open(`https://api.whatsapp.com/send?text=${text}`, \'_blank\');\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-2 sm:p-6\">\n      <div className=\"relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]\">\n        {/* Header */}\n        <div className=\"p-4 sm:p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-base sm:text-lg font-bold font-display text-slate-900\">\n              Resumo & Envio de Proposta\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              {quote.planName} \302\267 R$ {quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')} / m\303\252s\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-200/50 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-4 sm:p-6 overflow-y-auto space-y-5 sm:space-y-6 text-xs text-slate-700\">\n          {/* Quick Share Buttons */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3\">\n            <button\n              onClick={handleWhatsApp}\n              className=\"p-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors shadow-sm min-h-[44px]\"\n            >\n              <MessageSquare className=\"w-4 h-4\" />\n              <span>Enviar via WhatsApp</span>\n            </button>\n\n            <button\n              onClick={handleCopy}\n              className=\"p-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors border border-slate-200 min-h-[44px]\"\n            >\n              {copied ? <Check className=\"w-4 h-4 text-emerald-600\" /> : <Copy className=\"w-4 h-4\" />}\n              <span>{copied ? \'Copiado com Sucesso!\' : \'Copiar Texto Cota\303\247\303\243o\'}</span>\n            </button>\n\n            <button\n              onClick={handlePrint}\n              className=\"p-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors border border-slate-200 min-h-[44px]\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Imprimir / PDF</span>\n            </button>\n          </div>\n\n          {/* Form for Official Broker Proposal */}\n          <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-4\">\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                Receber Proposta Oficial de Corretora Credenciada\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Valida\303\247\303\243o de tabela regional vigente, car\303\252ncias e documenta\303\247\303\243o sem nenhum compromisso.\n              </p>\n            </div>\n\n            {submitted ? ("
    raw_content: "import React, { useState } from \'react\';\nimport { X, Copy, Check, MessageSquare, Printer, FileText, Send, Building } from \'lucide-react\';\nimport { CalculatedPlanQuote, QuoteInput } from \'../types/healthPlan\';\nimport { getAnsAgeBracketLabel } from \'../utils/pricingEngine\';\n\ninterface ExportSummaryModalProps {\n  quote: CalculatedPlanQuote | null;\n  input: QuoteInput;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const ExportSummaryModal: React.FC<ExportSummaryModalProps> = ({\n  quote,\n  input,\n  isOpen,\n  onClose,\n}) => {\n  const [copied, setCopied] = useState(false);\n  const [leadName, setLeadName] = useState(\'\');\n  const [leadEmail, setLeadEmail] = useState(\'\');\n  const [leadPhone, setLeadPhone] = useState(\'\');\n  const [submitted, setSubmitted] = useState(false);\n\n  if (!isOpen || !quote) return null;\n\n  const generateTextSummary = () => {\n    return `*COTA\303\207\303\203O ESTIMADA DE PLANO DE SA\303\232DE - COMPARA SA\303\232DE BRASIL*\n------------------------------------------------\n*Plano:* ${quote.planName} (${quote.operatorName})\n*Registro ANS:* ${quote.ansRegister} \302\267 *\303\215ndice IDSS:* ${quote.ansScore.toFixed(2)}\n*Modalidade:* ${input.contractType.toUpperCase()} | *Acomoda\303\247\303\243o:* ${quote.accommodation.toUpperCase()}\n*Coparticipa\303\247\303\243o:* ${quote.copay === \'com_coparticipacao\' ? \'SIM\' : \'N\303\203O\'}\n*Abrang\303\252ncia:* ${quote.coverageArea.toUpperCase()} | *UF:* ${input.state}\n\n*ESTIMATIVA TOTAL MENSAL:* R$ ${quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')} / m\303\252s\n(Intervalo de mercado: R$ ${quote.priceRangeMin} a R$ ${quote.priceRangeMax})\n\n*Detalhamento por Vida (${quote.perBeneficiaryBreakdown.length} vidas):*\n${quote.perBeneficiaryBreakdown\n  .map(\n    (b) =>\n      `- ${b.beneficiaryName}: ${b.age} anos (${getAnsAgeBracketLabel(b.ageBracket)}) -> R$ ${b.calculatedPrice.toLocaleString(\'pt-BR\')}`\n  )\n  .join(\'\\n\')}\n\n*Car\303\252ncias ANS B\303\241sicas:*\n- Urg\303\252ncia/Emerg\303\252ncia: 24h\n- Consultas e Exames: 30 dias\n- Cirurgias e Interna\303\247\303\265es: 180 dias\n- Parto: 300 dias\n\n*Principais Hospitais:*\n${quote.hospitals.slice(0, 5).map((h) => `\342\200\242 ${h}`).join(\'\\n\')}\n------------------------------------------------\n_Gerado via ComparaSa\303\272de Brasil em ${new Date().toLocaleDateString(\'pt-BR\')}_`;\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(generateTextSummary());\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2500);\n  };\n\n  const handleWhatsApp = () => {\n    const text = encodeURIComponent(generateTextSummary());\n    window.open(`https://api.whatsapp.com/send?text=${text}`, \'_blank\');\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-2 sm:p-6\">\n      <div className=\"relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]\">\n        {/* Header */}\n        <div className=\"p-4 sm:p-5 border-b border-slate-100 bg-slate-50 flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-base sm:text-lg font-bold font-display text-slate-900\">\n              Resumo & Envio de Proposta\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              {quote.planName} \302\267 R$ {quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')} / m\303\252s\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-200/50 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-4 sm:p-6 overflow-y-auto space-y-5 sm:space-y-6 text-xs text-slate-700\">\n          {/* Quick Share Buttons */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3\">\n            <button\n              onClick={handleWhatsApp}\n              className=\"p-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors shadow-sm min-h-[44px]\"\n            >\n              <MessageSquare className=\"w-4 h-4\" />\n              <span>Enviar via WhatsApp</span>\n            </button>\n\n            <button\n              onClick={handleCopy}\n              className=\"p-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors border border-slate-200 min-h-[44px]\"\n            >\n              {copied ? <Check className=\"w-4 h-4 text-emerald-600\" /> : <Copy className=\"w-4 h-4\" />}\n              <span>{copied ? \'Copiado com Sucesso!\' : \'Copiar Texto Cota\303\247\303\243o\'}</span>\n            </button>\n\n            <button\n              onClick={handlePrint}\n              className=\"p-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl font-semibold flex items-center justify-center gap-2 transition-colors border border-slate-200 min-h-[44px]\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Imprimir / PDF</span>\n            </button>\n          </div>\n\n          {/* Form for Official Broker Proposal */}\n          <div className=\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-4\">\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900\">\n                Receber Proposta Oficial de Corretora Credenciada\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Valida\303\247\303\243o de tabela regional vigente, car\303\252ncias e documenta\303\247\303\243o sem nenhum compromisso.\n              </p>\n            </div>\n\n            {submitted ? (\n              <div className=\"p-4 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-900 space-y-1\">\n                <div className=\"font-bold flex items-center gap-2 text-sm\">\n                  <Check className=\"w-4 h-4 text-emerald-600\" />\n                  Solicita\303\247\303\243o de cota\303\247\303\243o enviada!\n                </div>\n                <p className=\"text-xs\">\n                  O resumo da sua cota\303\247\303\243o estimada para {quote.planName} foi registrado. Em instantes um especialista entrar\303\241 em contato para confirmar descontos vigentes de {input.state}.\n                </p>\n              </div>\n            ) : (\n              <form onSubmit={handleFormSubmit} className=\"space-y-3\">\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"text-[11px] font-semibold text-slate-700 block uppercase mb-1\">\n                      Seu Nome Completo\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      value={leadName}\n                      onChange={(e) => setLeadName(e.target.value)}\n                      placeholder=\"Ex: Carlos Eduardo Silva\"\n                      className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"text-[11px] font-semibold text-slate-700 block uppercase mb-1\">\n                      Telefone Celular / WhatsApp\n                    </label>\n                    <input\n                      type=\"tel\"\n                      required\n                      value={leadPhone}\n                      onChange={(e) => setLeadPhone(e.target.value)}\n                      placeholder=\"(11) 98765-4321\"\n                      className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-[11px] font-semibold text-slate-700 block uppercase mb-1\">\n                    E-mail para Envio da Tabela Completa\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={leadEmail}\n                    onChange={(e) => setLeadEmail(e.target.value)}\n                    placeholder=\"carlos@exemplo.com.br\"\n                    className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                  />\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-2.5 px-4 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition-colors flex items-center justify-center gap-2 text-xs shadow-sm\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                  <span>Confirmar e Receber Proposta Detalhada</span>\n                </button>\n              </form>\n            )}\n          </div>\n\n          {/* Text preview */}\n          <div>\n            <label className=\"text-[11px] font-semibold text-slate-500 uppercase block mb-1.5\">\n              Pr\303\251via do Relat\303\263rio de Cota\303\247\303\243o\n            </label>\n            <pre className=\"p-3 bg-slate-100 rounded-lg text-[11px] font-mono text-slate-800 whitespace-pre-wrap overflow-x-auto max-h-40 border border-slate-200\">\n              {generateTextSummary()}\n            </pre>\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 bg-slate-50 border-t border-slate-200 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200 rounded-lg transition-colors\"\n          >\n            Fechar\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
