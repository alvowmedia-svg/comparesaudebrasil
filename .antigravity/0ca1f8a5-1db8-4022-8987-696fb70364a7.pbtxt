    content: "                }`}\n              >\n                {m.sender === \'user\' ? <User className=\"w-3.5 h-3.5\" /> : <Bot className=\"w-3.5 h-3.5\" />}\n              </div>\n\n              <div\n                className={`max-w-[85%] rounded-2xl p-3.5 shadow-sm leading-relaxed whitespace-pre-wrap ${\n                  m.sender === \'user\'\n                    ? \'bg-slate-900 text-white rounded-tr-none\'\n                    : \'bg-white text-slate-800 border border-slate-200 rounded-tl-none\'\n                }`}\n              >\n                {m.text}\n                <div\n                  className={`text-[9px] mt-1 text-right ${\n                    m.sender === \'user\' ? \'text-slate-400\' : \'text-slate-400\'\n                  }`}\n                >\n                  {m.time}\n                </div>\n              </div>\n            </div>\n          ))}\n\n          {isLoading && (\n            <div className=\"flex items-center gap-2 text-slate-500 italic text-xs p-2\">\n              <span className=\"w-2 h-2 rounded-full bg-teal-600 animate-ping\" />\n              <span>Analisando normativas da ANS e dados de mercado...</span>\n            </div>\n          )}\n        </div>\n\n        {/* Quick Suggestion Chips */}\n        <div className=\"p-2.5 bg-white border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto\">\n          {quickQuestions.map((q, i) => (\n            <button\n              key={i}\n              onClick={() => handleSendMessage(q)}\n              className=\"px-2.5 py-1 text-[11px] bg-slate-100 hover:bg-teal-50 hover:text-teal-900 text-slate-700 rounded-full transition-colors whitespace-nowrap shrink-0 border border-slate-200\"\n            >\n              {q}\n            </button>\n          ))}\n        </div>\n\n        {/* Input Bar */}\n        <div className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2\">\n          <input\n            type=\"text\"\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleSendMessage()}\n            placeholder=\"Tire d\303\272vidas sobre car\303\252ncias, coparticipa\303\247\303\243o, MEI ou coberturas...\"\n            className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n          />\n          <button\n            onClick={() => handleSendMessage()}\n            disabled={isLoading || !inputText.trim()}\n            className=\"p-2 bg-teal-600 hover:bg-teal-700 disabled:opacity-50 text-white rounded-lg transition-colors\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { X, Send, Sparkles, Bot, User, HelpCircle, CheckCircle } from \'lucide-react\';\nimport { QuoteInput } from \'../types/healthPlan\';\n\ninterface Message {\n  sender: \'ai\' | \'user\';\n  text: string;\n  time: string;\n}\n\ninterface AiHealthAdvisorProps {\n  isOpen: boolean;\n  onClose: () => void;\n  quoteContext: QuoteInput;\n}\n\nexport const AiHealthAdvisor: React.FC<AiHealthAdvisorProps> = ({\n  isOpen,\n  onClose,\n  quoteContext,\n}) => {\n  const [messages, setMessages] = useState<Message[]>([\n    {\n      sender: \'ai\',\n      text: `Ol\303\241! Sou o Consultor de Intelig\303\252ncia em Planos de Sa\303\272de. Analisei a sua simula\303\247\303\243o para ${\n        quoteContext.beneficiaries.length\n      } vida(s) no estado de ${quoteContext.state} (${\n        quoteContext.contractType === \'empresarial\' ? \'Empresarial / MEI\' : \'Individual\'\n      }). Como posso te orientar sobre coberturas, car\303\252ncias ANS, hospitais ou economia?`,\n      time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    },\n  ]);\n  const [inputText, setInputText] = useState(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n\n  if (!isOpen) return null;\n\n  const quickQuestions = [\n    \'Vale mais a pena com ou sem coparticipa\303\247\303\243o?\',\n    \'Como funciona a portabilidade de car\303\252ncias da ANS?\',\n    \'MEI com 6 meses de abertura j\303\241 pode contratar?\',\n    \'Como funciona a dedu\303\247\303\243o integral no Imposto de Renda?\',\n  ];\n\n  const handleSendMessage = async (textToSend?: string) => {\n    const query = textToSend || inputText;\n    if (!query.trim() || isLoading) return;\n\n    const userMsg: Message = {\n      sender: \'user\',\n      text: query,\n      time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setInputText(\'\');\n    setIsLoading(true);\n\n    try {\n      const res = await fetch(\'/api/ai-advisor\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          userMessage: query,\n          quoteContext,\n        }),\n      });\n\n      const data = await res.json();\n      const aiReply =\n        data.reply ||\n        \'N\303\243o foi poss\303\255vel obter resposta no momento. Por favor, verifique sua conex\303\243o ou tente novamente.\';\n\n      setMessages((prev) => [\n        ...prev,\n        {\n          sender: \'ai\',\n          text: aiReply,\n          time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n        },\n      ]);\n    } catch (err) {\n      setMessages((prev) => [\n        ...prev,\n        {\n          sender: \'ai\',\n          text: \'Prazos m\303\241ximos ANS: 24h para emerg\303\252ncias, 30 dias para consultas e exames simples, 180 dias para cirurgias e 300 dias para parto. A contrata\303\247\303\243o via MEI proporciona economia m\303\251dia de 30% em rela\303\247\303\243o ao plano individual com as mesmas coberturas hospitalares.\',\n          time: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n        },\n      ]);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-2 sm:p-6\">\n      <div className=\"relative w-full max-w-2xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col h-[560px] sm:h-[650px] max-h-[92vh]\">\n        {/* Header */}\n        <div className=\"p-3.5 sm:p-4 border-b border-slate-100 bg-teal-900 text-white flex items-center justify-between\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-teal-700 flex items-center justify-center shrink-0\">\n              <Sparkles className=\"w-4 h-4 text-teal-200\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5 flex-wrap\">\n                <h3 className=\"font-bold text-sm font-display\">Consultor Especialista ANS</h3>\n                <span className=\"text-[10px] bg-teal-800 text-teal-200 px-1.5 py-0.2 rounded font-mono\">\n                  Gemini IA\n                </span>\n              </div>\n              <p className=\"text-[11px] text-teal-200 line-clamp-1\">\n                Normativas da ANS e mercado de sa\303\272de\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-teal-200 hover:text-white rounded-lg hover:bg-teal-800 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Message Thread */}\n        <div className=\"flex-1 p-4 overflow-y-auto space-y-4 bg-slate-50 text-xs\">\n          {messages.map((m, idx) => (\n            <div\n              key={idx}\n              className={`flex items-start gap-2.5 ${m.sender === \'user\' ? \'flex-row-reverse\' : \'\'}`}\n            >\n              <div\n                className={`w-7 h-7 rounded-full flex items-center justify-center shrink-0 text-[11px] font-bold ${\n                  m.sender === \'user\' ? \'bg-slate-900 text-white\' : \'bg-teal-700 text-white\'\n                }`}\n              >\n                {m.sender === \'user\' ? <User className=\"w-3.5 h-3.5\" /> : <Bot className=\"w-3.5 h-3.5\" />}\n              </div>\n\n              <div\n                className={`max-w-[85%] rounded-2xl p-3.5 shadow-sm leading-relaxed whitespace-pre-wrap ${\n                  m.sender === \'user\'\n                    ? \'bg-slate-900 text-white rounded-tr-none\'\n                    : \'bg-white text-slate-800 border border-slate-200 rounded-tl-none\'\n                }`}\n              >\n                {m.text}\n                <div\n                  className={`text-[9px] mt-1 text-right ${\n                    m.sender === \'user\' ? \'text-slate-400\' : \'text-slate-400\'\n                  }`}\n                >\n                  {m.time}\n                </div>\n              </div>\n            </div>\n          ))}\n\n          {isLoading && (\n            <div className=\"flex items-center gap-2 text-slate-500 italic text-xs p-2\">\n              <span className=\"w-2 h-2 rounded-full bg-teal-600 animate-ping\" />\n              <span>Analisando normativas da ANS e dados de mercado...</span>\n            </div>\n          )}\n        </div>\n\n        {/* Quick Suggestion Chips */}\n        <div className=\"p-2.5 bg-white border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto\">\n          {quickQuestions.map((q, i) => (\n            <button\n              key={i}\n              onClick={() => handleSendMessage(q)}\n              className=\"px-2.5 py-1 text-[11px] bg-slate-100 hover:bg-teal-50 hover:text-teal-900 text-slate-700 rounded-full transition-colors whitespace-nowrap shrink-0 border border-slate-200\"\n            >\n              {q}\n            </button>\n          ))}\n        </div>\n\n        {/* Input Bar */}\n        <div className=\"p-3 bg-white border-t border-slate-200 flex items-center gap-2\">\n          <input\n            type=\"text\"\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleSendMessage()}\n            placeholder=\"Tire d\303\272vidas sobre car\303\252ncias, coparticipa\303\247\303\243o, MEI ou coberturas...\"\n            className=\"flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n          />\n          <button\n            onClick={() => handleSendMessage()}\n            disabled={isLoading || !inputText.trim()}\n            className=\"p-2 bg-teal-600 hover:bg-teal-700 disabled:opacity-50 text-white rounded-lg transition-colors\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 202
    num_bytes: 7811
  }
}
