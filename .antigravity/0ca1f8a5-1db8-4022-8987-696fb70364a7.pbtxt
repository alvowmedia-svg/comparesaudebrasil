    content: "import React from \'react\';\nimport { ArrowRight, CheckCircle2, Building2, FileCheck2 } from \'lucide-react\';\nimport heroImage from \'../assets/images/hero_healthcare_center_1790805973598.jpg\';\n\ninterface HeroSectionProps {\n  onStartSimulation: () => void;\n  onExploreHospitals: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({\n  onStartSimulation,\n  onExploreHospitals,\n}) => {\n  return (\n    <section className=\"relative overflow-hidden bg-slate-900 text-white pt-8 pb-12 sm:pt-12 sm:pb-16 lg:pt-16 lg:pb-24\">\n      {/* Background radial gradient mesh */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(13,148,136,0.3),rgba(255,255,255,0))]\" />\n\n      <div className=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\">\n          {/* Left Column: Proposition and Actions */}\n          <div className=\"lg:col-span-7 space-y-4 sm:space-y-6\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-medium text-teal-300\">\n              <span className=\"w-2 h-2 rounded-full bg-teal-400 animate-pulse shrink-0\" />\n              <span className=\"truncate\">Estimativas Atualizadas \302\267 Tabelas de Mercado 2026 ANS</span>\n            </div>\n\n            <h1 className=\"text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight font-display text-white leading-tight max-w-2xl\">\n              Compare planos de sa\303\272de com estimativas reais para o seu perfil.\n            </h1>\n\n            <p className=\"text-sm sm:text-base lg:text-lg text-slate-300 max-w-xl leading-relaxed\">\n              Algoritmo de c\303\241lculo com as 10 faixas et\303\241rias oficiais da ANS, desconto empresarial para MEI/PME,\n              compara\303\247\303\243o de rede hospitalar e simula\303\247\303\243o transparente vida a vida.\n            </p>\n\n            {/* CTAs */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1 sm:pt-2\">\n              <button\n                onClick={onStartSimulation}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-white bg-teal-600 hover:bg-teal-500 rounded-xl transition-colors whitespace-nowrap shadow-lg shadow-teal-900/30 min-h-[44px]\"\n              >\n                <span>Simular Cota\303\247\303\243o Agora</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={onExploreHospitals}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-slate-200 bg-slate-800/80 hover:bg-slate-700 hover:text-white rounded-xl transition-colors whitespace-nowrap border border-slate-700 min-h-[44px]\"\n              >\n                <span>Ver Hospitais Credenciados</span>\n              </button>\n            </div>\n\n            {/* Trust points - responsive stack on mobile */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 pt-4 sm:pt-6 border-t border-slate-800 text-xs text-slate-300\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>10 Faixas Et\303\241rias ANS</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <Building2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>MEI a partir de 1 Vida</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <FileCheck2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>100% Dedut\303\255vel no IRPF</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Hero Visual Asset */}\n          <div className=\"lg:col-span-5 relative mt-4 lg:mt-0\">\n            <div className=\"relative rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-slate-800\">\n              <img\n                src={heroImage}\n                alt=\"Equipe m\303\251dica e estrutura hospitalar de excel\303\252ncia\"\n                referrerPolicy=\"no-referrer\"\n                className=\"w-full h-56 sm:h-80 lg:h-96 object-cover\"\n                loading=\"eager\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent\" />\n              <div className=\"absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-3 sm:p-4 rounded-xl bg-slate-900/85 backdrop-blur-md border border-slate-700/80 text-xs text-slate-200\">\n                <div className=\"flex items-center justify-between font-semibold text-white mb-1\">\n                  <span>Operadoras Monitoradas</span>\n                  <span className=\"text-teal-400 font-mono text-[11px]\">IDSS M\303\251dio 0.93</span>\n                </div>\n                <p className=\"text-slate-400 text-[11px] leading-relaxed\">\n                  Bradesco Sa\303\272de, Amil, SulAm\303\251rica, GNDI Notredame, Unimed, Porto Seguro, Alice e Hapvida.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { ArrowRight, CheckCircle2, Building2, FileCheck2 } from \'lucide-react\';\nimport heroImage from \'../assets/images/hero_healthcare_center_1790805973598.jpg\';\n\ninterface HeroSectionProps {\n  onStartSimulation: () => void;\n  onExploreHospitals: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({\n  onStartSimulation,\n  onExploreHospitals,\n}) => {\n  return (\n    <section className=\"relative overflow-hidden bg-slate-900 text-white pt-8 pb-12 sm:pt-12 sm:pb-16 lg:pt-16 lg:pb-24\">\n      {/* Background radial gradient mesh */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(13,148,136,0.3),rgba(255,255,255,0))]\" />\n\n      <div className=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\">\n          {/* Left Column: Proposition and Actions */}\n          <div className=\"lg:col-span-7 space-y-4 sm:space-y-6\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-medium text-teal-300\">\n              <span className=\"w-2 h-2 rounded-full bg-teal-400 animate-pulse shrink-0\" />\n              <span className=\"truncate\">Estimativas Atualizadas \302\267 Tabelas de Mercado 2026 ANS</span>\n            </div>\n\n            <h1 className=\"text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight font-display text-white leading-tight max-w-2xl\">\n              Compare planos de sa\303\272de com estimativas reais para o seu perfil.\n            </h1>\n\n            <p className=\"text-sm sm:text-base lg:text-lg text-slate-300 max-w-xl leading-relaxed\">\n              Algoritmo de c\303\241lculo com as 10 faixas et\303\241rias oficiais da ANS, desconto empresarial para MEI/PME,\n              compara\303\247\303\243o de rede hospitalar e simula\303\247\303\243o transparente vida a vida.\n            </p>\n\n            {/* CTAs */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1 sm:pt-2\">\n              <button\n                onClick={onStartSimulation}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-white bg-teal-600 hover:bg-teal-500 rounded-xl transition-colors whitespace-nowrap shadow-lg shadow-teal-900/30 min-h-[44px]\"\n              >\n                <span>Simular Cota\303\247\303\243o Agora</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={onExploreHospitals}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold text-slate-200 bg-slate-800/80 hover:bg-slate-700 hover:text-white rounded-xl transition-colors whitespace-nowrap border border-slate-700 min-h-[44px]\"\n              >\n                <span>Ver Hospitais Credenciados</span>\n              </button>\n            </div>\n\n            {/* Trust points - responsive stack on mobile */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-4 pt-4 sm:pt-6 border-t border-slate-800 text-xs text-slate-300\">\n              <div className=\"flex items-center gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>10 Faixas Et\303\241rias ANS</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <Building2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>MEI a partir de 1 Vida</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <FileCheck2 className=\"w-4 h-4 text-teal-400 shrink-0\" />\n                <span>100% Dedut\303\255vel no IRPF</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Hero Visual Asset */}\n          <div className=\"lg:col-span-5 relative mt-4 lg:mt-0\">\n            <div className=\"relative rounded-2xl overflow-hidden shadow-2xl border border-slate-800 bg-slate-800\">\n              <img\n                src={heroImage}\n                alt=\"Equipe m\303\251dica e estrutura hospitalar de excel\303\252ncia\"\n                referrerPolicy=\"no-referrer\"\n                className=\"w-full h-56 sm:h-80 lg:h-96 object-cover\"\n                loading=\"eager\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent\" />\n              <div className=\"absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 p-3 sm:p-4 rounded-xl bg-slate-900/85 backdrop-blur-md border border-slate-700/80 text-xs text-slate-200\">\n                <div className=\"flex items-center justify-between font-semibold text-white mb-1\">\n                  <span>Operadoras Monitoradas</span>\n                  <span className=\"text-teal-400 font-mono text-[11px]\">IDSS M\303\251dio 0.93</span>\n                </div>\n                <p className=\"text-slate-400 text-[11px] leading-relaxed\">\n                  Bradesco Sa\303\272de, Amil, SulAm\303\251rica, GNDI Notredame, Unimed, Porto Seguro, Alice e Hapvida.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
