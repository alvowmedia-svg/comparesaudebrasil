    content: "import React, { useState } from \'react\';\nimport { ShieldCheck, Clock, CheckCircle2, DollarSign, Calculator, ArrowRight } from \'lucide-react\';\nimport familyImage from \'../assets/images/family_health_consult_1790805998071.jpg\';\nimport { calculateEstimatedTaxSavings } from \'../utils/pricingEngine\';\n\nexport const RegulatorySection: React.FC = () => {\n  const [annualSpend, setAnnualSpend] = useState<number>(12000);\n  const estimatedTaxReturn = calculateEstimatedTaxSavings(annualSpend, 27.5);\n\n  return (\n    <section id=\"regras-ans\" className=\"py-16 bg-white border-t border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Section Title */}\n        <div className=\"max-w-3xl\">\n          <span className=\"text-xs font-semibold text-teal-700 uppercase tracking-wider\">\n            Diretrizes Oficiais de Sa\303\272de Suplementar\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-display text-slate-900 tracking-tight mt-1\">\n            Transpar\303\252ncia atuarial: entenda como a ANS regula seu plano.\n          </h2>\n          <p className=\"text-sm text-slate-600 mt-2\">\n            No Brasil, a Lei Federal n\302\272 9.656/1998 e as resolu\303\247\303\265es da Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS)\n            garantem padr\303\265es inegoci\303\241veis de atendimento, car\303\252ncias e reajustes.\n          </p>\n        </div>\n\n        {/* 3 Pillars Bento Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          {/* Bento Card 1: Car\303\252ncias Timeline */}\n          <div className=\"lg:col-span-7 p-6 sm:p-8 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col justify-between space-y-6\">\n            <div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-teal-800 mb-2\">\n                <Clock className=\"w-4 h-4 text-teal-600\" />\n                <span>Prazos Legais de Car\303\252ncia</span>\n              </div>\n              <h3 className=\"text-xl font-bold font-display text-slate-900\">\n                Prazos m\303\241ximos permitidos por lei ap\303\263s a contrata\303\247\303\243o\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-1\">\n                Nenhuma operadora pode cobrar car\303\252ncia superior a estes prazos. Em caso de urg\303\252ncia, a cobertura \303\251 imediata ap\303\263s 24h.\n              </p>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Urg\303\252ncia & Emerg\303\252ncia</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">24 Horas</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Consultas M\303\251dicas & Exames Simples</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">30 Dias</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Cirurgias, Interna\303\247\303\265es & Exames Especiais</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">180 Dias</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Parto a Termo</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">300 Dias</span>\n              </div>"
    raw_content: "import React, { useState } from \'react\';\nimport { ShieldCheck, Clock, CheckCircle2, DollarSign, Calculator, ArrowRight } from \'lucide-react\';\nimport familyImage from \'../assets/images/family_health_consult_1790805998071.jpg\';\nimport { calculateEstimatedTaxSavings } from \'../utils/pricingEngine\';\n\nexport const RegulatorySection: React.FC = () => {\n  const [annualSpend, setAnnualSpend] = useState<number>(12000);\n  const estimatedTaxReturn = calculateEstimatedTaxSavings(annualSpend, 27.5);\n\n  return (\n    <section id=\"regras-ans\" className=\"py-16 bg-white border-t border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n        {/* Section Title */}\n        <div className=\"max-w-3xl\">\n          <span className=\"text-xs font-semibold text-teal-700 uppercase tracking-wider\">\n            Diretrizes Oficiais de Sa\303\272de Suplementar\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-display text-slate-900 tracking-tight mt-1\">\n            Transpar\303\252ncia atuarial: entenda como a ANS regula seu plano.\n          </h2>\n          <p className=\"text-sm text-slate-600 mt-2\">\n            No Brasil, a Lei Federal n\302\272 9.656/1998 e as resolu\303\247\303\265es da Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS)\n            garantem padr\303\265es inegoci\303\241veis de atendimento, car\303\252ncias e reajustes.\n          </p>\n        </div>\n\n        {/* 3 Pillars Bento Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          {/* Bento Card 1: Car\303\252ncias Timeline */}\n          <div className=\"lg:col-span-7 p-6 sm:p-8 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col justify-between space-y-6\">\n            <div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-teal-800 mb-2\">\n                <Clock className=\"w-4 h-4 text-teal-600\" />\n                <span>Prazos Legais de Car\303\252ncia</span>\n              </div>\n              <h3 className=\"text-xl font-bold font-display text-slate-900\">\n                Prazos m\303\241ximos permitidos por lei ap\303\263s a contrata\303\247\303\243o\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-1\">\n                Nenhuma operadora pode cobrar car\303\252ncia superior a estes prazos. Em caso de urg\303\252ncia, a cobertura \303\251 imediata ap\303\263s 24h.\n              </p>\n            </div>\n\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Urg\303\252ncia & Emerg\303\252ncia</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">24 Horas</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Consultas M\303\251dicas & Exames Simples</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">30 Dias</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Cirurgias, Interna\303\247\303\265es & Exames Especiais</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">180 Dias</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Parto a Termo</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">300 Dias</span>\n              </div>\n              <div className=\"flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl text-xs\">\n                <span className=\"font-semibold text-slate-800\">Doen\303\247as e Les\303\265es Preexistentes (CPT)</span>\n                <span className=\"font-mono font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded\">24 Meses</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Bento Card 2: Visual Asset & Family Health */}\n          <div className=\"lg:col-span-5 relative rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-900 text-white min-h-[340px] flex flex-col justify-end p-6\">\n            <img\n              src={familyImage}\n              alt=\"Atendimento pedi\303\241trico e familiar em cl\303\255nica de sa\303\272de\"\n              referrerPolicy=\"no-referrer\"\n              className=\"absolute inset-0 w-full h-full object-cover\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent\" />\n\n            <div className=\"relative space-y-2\">\n              <span className=\"text-xs font-semibold text-teal-300 uppercase\">\n                Portabilidade sem Car\303\252ncia\n              </span>\n              <h3 className=\"text-lg font-bold font-display text-white\">\n                J\303\241 tem plano h\303\241 mais de 2 anos?\n              </h3>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">\n                Voc\303\252 pode migrar para outra operadora com mensalidade menor mantendo a isen\303\247\303\243o de car\303\252ncias conquistada no plano anterior.\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* IRPF Tax Deductibility Interactive Simulator */}\n        <div className=\"p-6 sm:p-8 bg-slate-900 text-white rounded-2xl border border-slate-800\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            <div className=\"lg:col-span-7 space-y-3\">\n              <div className=\"inline-flex items-center gap-2 text-xs font-medium text-teal-300\">\n                <Calculator className=\"w-4 h-4 text-teal-400\" />\n                <span>Simulador de Benef\303\255cio Fiscal IRPF</span>\n              </div>\n              <h3 className=\"text-xl sm:text-2xl font-bold font-display text-white\">\n                100% dos gastos com plano de sa\303\272de s\303\243o dedut\303\255veis no Imposto de Renda.\n              </h3>\n              <p className=\"text-xs sm:text-sm text-slate-300 leading-relaxed\">\n                Ao contr\303\241rio de educa\303\247\303\243o (que tem teto m\303\241ximo), a Receita Federal permite deduzir integralmente todas as despesas m\303\251dicas e mensalidades do plano para voc\303\252 e dependentes legais na declara\303\247\303\243o completa.\n              </p>\n\n              {/* Slider */}\n              <div className=\"pt-4 space-y-2\">\n                <div className=\"flex items-center justify-between text-xs text-slate-300\">\n                  <span>Gasto Anual Estimado com Plano de Sa\303\272de:</span>\n                  <span className=\"font-mono font-bold text-white text-base\">\n                    R$ {annualSpend.toLocaleString(\'pt-BR\')} / ano\n                  </span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"3000\"\n                  max=\"40000\"\n                  step=\"1000\"\n                  value={annualSpend}\n                  onChange={(e) => setAnnualSpend(Number(e.target.value))}\n                  className=\"w-full accent-teal-500 cursor-pointer\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-500 font-mono\">\n                  <span>R$ 3.000 (R$ 250/m\303\252s)</span>\n                  <span>R$ 20.000 (R$ 1.660/m\303\252s)</span>\n                  <span>R$ 40.000 (R$ 3.330/m\303\252s)</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Calculated Output Card */}\n            <div className=\"lg:col-span-5 p-6 bg-slate-800/90 rounded-xl border border-slate-700 space-y-3\">\n              <div className=\"text-xs text-slate-400 uppercase font-semibold\">\n                Estimativa de Retorno no IRPF (Faixa 27,5%)\n              </div>\n              <div className=\"text-3xl font-extrabold text-teal-400 font-mono tabular-nums\">\n                R$ {estimatedTaxReturn.toLocaleString(\'pt-BR\')}\n              </div>\n              <p className=\"text-xs text-slate-300 leading-relaxed\">\n                Valor estimado que voc\303\252 pode receber de volta na restitui\303\247\303\243o ou economizar no imposto a pagar.\n              </p>\n              <div className=\"pt-2 text-[11px] text-slate-400 border-t border-slate-700/80\">\n                Custo real efetivo anual do plano:{\' \'}\n                <strong className=\"text-white font-mono\">\n                  R$ {(annualSpend - estimatedTaxReturn).toLocaleString(\'pt-BR\')}\n                </strong>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 156
    num_bytes: 8704
  }
}
