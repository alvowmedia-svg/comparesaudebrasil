Filters */}\n        {activeTab === \'filters\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Filtrar por Hospitais de Excel\303\252ncia Desejados (Opcional)\n              </label>\n              <p className=\"text-xs text-slate-500 mb-3\">\n                Selecione os hospitais que voc\303\252 faz quest\303\243o que estejam credenciados:\n              </p>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2\">\n                {REFERENCE_HOSPITALS.slice(0, 9).map((h) => {\n                  const isSelected = (currentInput.selectedHospitals || []).includes(h.name);\n                  return (\n                    <button\n                      key={h.name}\n                      onClick={() => {\n                        const current = currentInput.selectedHospitals || [];\n                        const updated = isSelected\n                          ? current.filter((item) => item !== h.name)\n                          : [...current, h.name];\n                        updateField(\'selectedHospitals\', updated);\n                      }}\n                      className={`text-left p-3 rounded-xl border text-xs transition-all min-h-[44px] ${\n                        isSelected\n                          ? \'border-teal-600 bg-teal-50 text-teal-900 font-semibold\'\n                          : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                      }`}\n                    >\n                      <div className=\"truncate font-medium\">{h.name}</div>\n                      <div className=\"text-[10px] text-slate-400\">\n                        {h.city} \302\267 {h.tier === \'excelencia\' ? \'N\303\255vel A\' : \'Refer\303\252ncia\'}\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Filtrar por Operadora\n                </label>\n                <select\n                  value={currentInput.operatorFilter || \'all\'}\n                  onChange={(e) => updateField(\'operatorFilter\', e.target.value)}\n                  className=\"w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 min-h-[44px]\"\n                >\n                  <option value=\"all\">Todas as Operadoras</option>\n                  <option value=\"bradesco\">Bradesco Sa\303\272de</option>\n                  <option value=\"amil\">Amil Sa\303\272de</option>\n                  <option value=\"sulamerica\">SulAm\303\251rica Sa\303\272de</option>\n                  <option value=\"gndi\">NotreDame Interm\303\251dica (GNDI)</option>\n                  <option value=\"unimed\">Unimed</option>\n                  <option value=\"portoseguro\">Porto Seguro Sa\303\272de</option>\n                  <option value=\"alice\">Alice</option>\n                  <option value=\"hapvida\">Hapvida</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Teto M\303\241ximo Mensal Desejado (R$)\n                </label>\n                <input\n                  type=\"number\"\n                  placeholder=\"Ex: 1500 (Em branco = sem limite)\"\n                  value={currentInput.maxMonthlyBudget || \'\'}\n                  onChange={(e) =>\n                    updateField(\n                      \'maxMonthlyBudget\',\n                      e.target.value ? parseFloat(e.target.value) : undefined\n                    )\n                  }\n                  className=\"w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 font-mono min-h-[44px]\"\n                />\n              </div>\n            </div>\n\n            {/* Step Navigation to Simulate */}\n            <div className=\"pt-2 flex items-center justify-between gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'coverage\')}\n                className=\"inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition-colors min-h-[44px]\"\n              >\n                <ArrowLeft className=\"w-4 h-4\" />\n                <span>Voltar</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={onSimulate}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors min-h-[44px] active:scale-[0.99]\"\n              >\n                <span>Ver Planos & Cota\303\247\303\243o</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Footer action bar */}\n      <div className=\"p-3.5 sm:p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\">\n        <div className=\"text-xs text-slate-500 text-center sm:text-left\">\n          Total: <strong className=\"text-slate-900\">{currentInput.beneficiaries.length} vidas</strong> em{\' \'}\n          <strong className=\"text-slate-900\">{currentInput.state}</strong> (\n          {currentInput.contractType === \'empresarial\'\n            ? \'Empresarial / MEI\'\n            : currentInput.contractType === \'adesao\'\n            ? \'Ades\303\243o\'\n            : \'Individual PF\'}\n          ).\n        </div>\n\n        <button\n          onClick={onSimulate}\n          className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-xl transition-colors shadow-xs min-h-[48px] active:scale-[0.99]\"\n        >\n          <span>Atualizar Estimativas & Compara\303\247\303\243o</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>"
      }
      num_matches: 1
    }
  }
}
