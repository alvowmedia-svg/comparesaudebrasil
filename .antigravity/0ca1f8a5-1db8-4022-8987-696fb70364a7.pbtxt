    content: "          </button>\n        </div>\n\n        {/* Mobile Swipe Hint */}\n        <div className=\"sm:hidden px-4 py-2 bg-teal-50 border-b border-teal-100 text-[11px] font-medium text-teal-800 flex items-center justify-center text-center\">\n          <span>\360\237\221\210 Deslize a tabela para comparar todos os planos \360\237\221\211</span>\n        </div>\n\n        {/* Comparison Table Content */}\n        <div className=\"overflow-x-auto p-3 sm:p-6 flex-1 -webkit-overflow-scrolling-touch\">\n          <table className=\"w-full text-xs text-left border-collapse\">\n            <thead>\n              <tr>\n                <th className=\"p-3 w-48 font-bold text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-200\">\n                  Item Comparativo\n                </th>\n                {selectedPlans.map((plan) => (\n                  <th\n                    key={plan.planId}\n                    className=\"p-3 font-semibold text-slate-900 border-b border-slate-200 min-w-[220px]\"\n                  >\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"text-[11px] text-slate-500\">{plan.operatorName}</span>\n                      <button\n                        onClick={() => onRemovePlan(plan.planId)}\n                        className=\"text-[10px] text-rose-500 hover:underline\"\n                      >\n                        Remover\n                      </button>\n                    </div>\n                    <div className=\"text-sm font-bold font-display leading-tight\">{plan.planName}</div>\n                    <div className=\"mt-2 text-xl font-extrabold font-mono text-slate-900 tabular-nums\">\n                      R$ {plan.totalMonthlyPrice.toLocaleString(\'pt-BR\')}\n                      <span className=\"text-xs text-slate-400 font-normal\"> /m\303\252s</span>\n                    </div>\n                    <div className=\"text-[10px] text-slate-400 font-mono\">\n                      R$ {plan.priceRangeMin} ~ R$ {plan.priceRangeMax}\n                    </div>\n                  </th>\n                ))}\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {/* Registro ANS & IDSS */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">\303\215ndice ANS IDSS</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-bold text-slate-900\">\n                    <span className=\"inline-flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3.5 h-3.5 text-teal-600\" />\n                      {p.ansScore.toFixed(2)} (ANS {p.ansRegister})\n                    </span>\n                  </td>\n                ))}\n              </tr>\n\n              {/* Acomoda\303\247\303\243o */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Acomoda\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-semibold capitalize\">\n                    {p.accommodation}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Coparticipa\303\247\303\243o */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Coparticipa\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.copay === \'com_coparticipacao\' ? (\n                      <span className=\"text-emerald-700 font-semibold\">Com Coparticipa\303\247\303\243o (~24% menor)</span>\n                    ) : (\n                      <span className=\"text-slate-800 font-semibold\">Sem Coparticipa\303\247\303\243o</span>\n                    )}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Reembolso */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Reembolso Consulta</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-mono font-semibold\">\n                    {p.reimbursementConsultation > 0"
    raw_content: "import React from \'react\';\nimport { X, Check, Minus, ShieldCheck, Download, MessageCircle, ExternalLink } from \'lucide-react\';\nimport { CalculatedPlanQuote } from \'../types/healthPlan\';\n\ninterface SideBySideModalProps {\n  selectedPlans: CalculatedPlanQuote[];\n  isOpen: boolean;\n  onClose: () => void;\n  onRemovePlan: (planId: string) => void;\n  onRequestProposal: (quote: CalculatedPlanQuote) => void;\n}\n\nexport const SideBySideModal: React.FC<SideBySideModalProps> = ({\n  selectedPlans,\n  isOpen,\n  onClose,\n  onRemovePlan,\n  onRequestProposal,\n}) => {\n  if (!isOpen || selectedPlans.length === 0) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-2 sm:p-6\">\n      <div className=\"relative w-full max-w-5xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[92vh]\">\n        {/* Header */}\n        <div className=\"p-4 sm:p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50\">\n          <div>\n            <h2 className=\"text-base sm:text-lg font-bold font-display text-slate-900\">\n              Compara\303\247\303\243o Lado a Lado ({selectedPlans.length} planos)\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              An\303\241lise comparativa direta de valores, car\303\252ncias ANS, rede hospitalar e benef\303\255cios.\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 text-slate-400 hover:text-slate-700 rounded-lg hover:bg-slate-200/50 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Mobile Swipe Hint */}\n        <div className=\"sm:hidden px-4 py-2 bg-teal-50 border-b border-teal-100 text-[11px] font-medium text-teal-800 flex items-center justify-center text-center\">\n          <span>\360\237\221\210 Deslize a tabela para comparar todos os planos \360\237\221\211</span>\n        </div>\n\n        {/* Comparison Table Content */}\n        <div className=\"overflow-x-auto p-3 sm:p-6 flex-1 -webkit-overflow-scrolling-touch\">\n          <table className=\"w-full text-xs text-left border-collapse\">\n            <thead>\n              <tr>\n                <th className=\"p-3 w-48 font-bold text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-200\">\n                  Item Comparativo\n                </th>\n                {selectedPlans.map((plan) => (\n                  <th\n                    key={plan.planId}\n                    className=\"p-3 font-semibold text-slate-900 border-b border-slate-200 min-w-[220px]\"\n                  >\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"text-[11px] text-slate-500\">{plan.operatorName}</span>\n                      <button\n                        onClick={() => onRemovePlan(plan.planId)}\n                        className=\"text-[10px] text-rose-500 hover:underline\"\n                      >\n                        Remover\n                      </button>\n                    </div>\n                    <div className=\"text-sm font-bold font-display leading-tight\">{plan.planName}</div>\n                    <div className=\"mt-2 text-xl font-extrabold font-mono text-slate-900 tabular-nums\">\n                      R$ {plan.totalMonthlyPrice.toLocaleString(\'pt-BR\')}\n                      <span className=\"text-xs text-slate-400 font-normal\"> /m\303\252s</span>\n                    </div>\n                    <div className=\"text-[10px] text-slate-400 font-mono\">\n                      R$ {plan.priceRangeMin} ~ R$ {plan.priceRangeMax}\n                    </div>\n                  </th>\n                ))}\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {/* Registro ANS & IDSS */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">\303\215ndice ANS IDSS</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-bold text-slate-900\">\n                    <span className=\"inline-flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3.5 h-3.5 text-teal-600\" />\n                      {p.ansScore.toFixed(2)} (ANS {p.ansRegister})\n                    </span>\n                  </td>\n                ))}\n              </tr>\n\n              {/* Acomoda\303\247\303\243o */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Acomoda\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-semibold capitalize\">\n                    {p.accommodation}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Coparticipa\303\247\303\243o */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Coparticipa\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.copay === \'com_coparticipacao\' ? (\n                      <span className=\"text-emerald-700 font-semibold\">Com Coparticipa\303\247\303\243o (~24% menor)</span>\n                    ) : (\n                      <span className=\"text-slate-800 font-semibold\">Sem Coparticipa\303\247\303\243o</span>\n                    )}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Reembolso */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Reembolso Consulta</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-mono font-semibold\">\n                    {p.reimbursementConsultation > 0\n                      ? `R$ ${p.reimbursementConsultation}`\n                      : \'Sem reembolso (apenas rede)\'}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Abrang\303\252ncia */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Abrang\303\252ncia</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 capitalize font-medium\">\n                    {p.coverageArea}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Car\303\252ncia Urg\303\252ncia */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Car\303\252ncia Urg\303\252ncia</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3 font-medium\">\n                    {p.emergencyWaitHours} horas (ANS Padr\303\243o)\n                  </td>\n                ))}\n              </tr>\n\n              {/* Car\303\252ncia Consultas */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Car\303\252ncia Consultas/Exames</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.consultationWaitDays} dias\n                  </td>\n                ))}\n              </tr>\n\n              {/* Car\303\252ncia Cirurgias */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Car\303\252ncia Cirurgia / Interna\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.surgeryWaitDays} dias (180 dias)\n                  </td>\n                ))}\n              </tr>\n\n              {/* Car\303\252ncia Parto */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Car\303\252ncia Parto a Termo</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.maternityWaitDays} dias (300 dias)\n                  </td>\n                ))}\n              </tr>\n\n              {/* Car\303\252ncia Doen\303\247as Preexistentes (CPT) */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Car\303\252ncia CPT Preexistentes</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.preExistingWaitMonths} meses (cobertura parcial)\n                  </td>\n                ))}\n              </tr>\n\n              {/* Telemedicina 24h */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Telemedicina 24h</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.telemedicine ? (\n                      <span className=\"text-teal-700 font-semibold flex items-center gap-1\">\n                        <Check className=\"w-3.5 h-3.5\" /> Inclusa via App\n                      </span>\n                    ) : (\n                      <Minus className=\"w-3.5 h-3.5 text-slate-400\" />\n                    )}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Seguro Viagem */}\n              <tr>\n                <td className=\"p-3 font-medium text-slate-600\">Seguro Viagem</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    {p.travelInsurance ? (\n                      <span className=\"text-teal-700 font-semibold flex items-center gap-1\">\n                        <Check className=\"w-3.5 h-3.5\" /> Incluso\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400\">Opcional / N\303\243o incluso</span>\n                    )}\n                  </td>\n                ))}\n              </tr>\n\n              {/* Principais Hospitais */}\n              <tr className=\"bg-slate-50/40\">\n                <td className=\"p-3 font-medium text-slate-600\">Hospitais de Destaque</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    <ul className=\"space-y-1 text-[11px] text-slate-700\">\n                      {p.hospitals.slice(0, 4).map((h, i) => (\n                        <li key={i}>\342\200\242 {h}</li>\n                      ))}\n                    </ul>\n                  </td>\n                ))}\n              </tr>\n            </tbody>\n            <tfoot>\n              <tr>\n                <td className=\"p-3 font-bold text-slate-600\">A\303\247\303\243o</td>\n                {selectedPlans.map((p) => (\n                  <td key={p.planId} className=\"p-3\">\n                    <button\n                      onClick={() => {\n                        onClose();\n                        onRequestProposal(p);\n                      }}\n                      className=\"w-full py-2 px-3 text-xs font-semibold text-white bg-teal-600 hover:bg-teal-700 rounded-lg transition-colors whitespace-nowrap\"\n                    >\n                      Solicitar Cota\303\247\303\243o\n                    </button>\n                  </td>\n                ))}\n              </tr>\n            </tfoot>\n          </table>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n          <span>*Valores estimados segundo a m\303\251dia de mercado e normativas ANS RN 563.</span>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 text-slate-700 hover:bg-slate-200/60 rounded-lg font-medium transition-colors\"\n          >\n            Fechar\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 273
    num_bytes: 11561
  }
}
