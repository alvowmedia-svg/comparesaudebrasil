    content: "                    onClick={() => updateField(\'copay\', \'com_coparticipacao\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.copay === \'com_coparticipacao\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"font-bold text-sm\">Com Coparticipa\303\247\303\243o</span>\n                      <span className=\"text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded\">\n                        -24%\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-500\">\n                      Mensalidade mais barata. Pequena taxa apenas ao usar consultas/exames.\n                    </p>\n                  </div>\n\n                  <div\n                    onClick={() => updateField(\'copay\', \'sem_coparticipacao\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.copay === \'sem_coparticipacao\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-sm mb-1\">Sem Coparticipa\303\247\303\243o</div>\n                    <p className=\"text-xs text-slate-500\">\n                      Mensalidade fixa total. Custo zero ao consultar m\303\251dicos ou realizar exames.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Abrang\303\252ncia Geogr\303\241fica */}\n            <div className=\"pt-4 border-t border-slate-100\">\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Abrang\303\252ncia Geogr\303\241fica\n              </label>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div\n                  onClick={() => updateField(\'coverageArea\', \'regional\')}\n                  className={`cursor-pointer p-3.5 rounded-xl border-2 transition-all ${\n                    currentInput.coverageArea === \'regional\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs mb-0.5\">Regional / Grupo de Munic\303\255pios</div>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Focado na sua regi\303\243o metropolitana e cidades vizinhas. Maior custo-benef\303\255cio.\n                  </p>\n                </div>\n\n                <div\n                  onClick={() => updateField(\'coverageArea\', \'nacional\')}\n                  className={`cursor-pointer p-3.5 rounded-xl border-2 transition-all ${\n                    currentInput.coverageArea === \'nacional\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs mb-0.5\">Nacional (Todo o Brasil)</div>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Atendimento eletivo e de urg\303\252ncia em qualquer estado da federa\303\247\303\243o.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 4: Reference Hospitals & Advanced Filters */}\n        {activeTab === \'filters\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Filtrar por Hospitais de Excel\303\252ncia Desejados (Opcional)\n              </label>\n              <p className=\"text-xs text-slate-500 mb-3\">\n                Selecione os hospitais que voc\303\252 faz quest\303\243o que estejam credenciados:\n              </p>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2\">\n                {REFERENCE_HOSPITALS.slice(0, 9).map((h) => {\n                  const isSelected = (currentInput.selectedHospitals || []).includes(h.name);\n                  return (\n                    <button\n                      key={h.name}\n                      onClick={() => {\n                        const current = currentInput.selectedHospitals || [];\n                        const updated = isSelected\n                          ? current.filter((item) => item !== h.name)\n                          : [...current, h.name];\n                        updateField(\'selectedHospitals\', updated);\n                      }}\n                      className={`text-left p-2.5 rounded-lg border text-xs transition-all ${\n                        isSelected\n                          ? \'border-teal-600 bg-teal-50 text-teal-900 font-semibold\'\n                          : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                      }`}\n                    >\n                      <div className=\"truncate\">{h.name}</div>\n                      <div className=\"text-[10px] text-slate-400\">\n                        {h.city} \302\267 {h.tier === \'excelencia\' ? \'N\303\255vel A\' : \'Refer\303\252ncia\'}\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Filtrar por Operadora\n                </label>\n                <select\n                  value={currentInput.operatorFilter || \'all\'}\n                  onChange={(e) => updateField(\'operatorFilter\', e.target.value)}\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                >\n                  <option value=\"all\">Todas as Operadoras</option>\n                  <option value=\"bradesco\">Bradesco Sa\303\272de</option>\n                  <option value=\"amil\">Amil Sa\303\272de</option>\n                  <option value=\"sulamerica\">SulAm\303\251rica Sa\303\272de</option>\n                  <option value=\"gndi\">NotreDame Interm\303\251dica (GNDI)</option>\n                  <option value=\"unimed\">Unimed</option>\n                  <option value=\"portoseguro\">Porto Seguro Sa\303\272de</option>\n                  <option value=\"alice\">Alice</option>\n                  <option value=\"hapvida\">Hapvida</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Teto M\303\241ximo Mensal Desejado (R$)\n                </label>\n                <input\n                  type=\"number\"\n                  placeholder=\"Ex: 1500 (Deixe em branco para sem limite)\""
    raw_content: "import React, { useState } from \'react\';\nimport {\n  Users,\n  Building2,\n  User,\n  Plus,\n  Minus,\n  Trash2,\n  Sliders,\n  Shield,\n  MapPin,\n  Sparkles,\n  Info,\n  Building,\n  Crosshair,\n  Loader2,\n  CheckCircle2,\n  Search,\n  ArrowRight,\n  ArrowLeft,\n} from \'lucide-react\';\nimport {\n  AccommodationType,\n  Beneficiary,\n  ContractType,\n  CopayType,\n  CoverageArea,\n  DetectedLocation,\n  QuoteInput,\n} from \'../types/healthPlan\';\nimport { BRAZILIAN_STATES, REFERENCE_HOSPITALS } from \'../data/healthPlans\';\nimport { getAnsAgeBracket, getAnsAgeBracketLabel, ANS_BRACKET_FACTORS } from \'../utils/pricingEngine\';\nimport { detectLocationByGps, lookupCep, formatCep } from \'../utils/locationService\';\n\ninterface QuoteWizardProps {\n  currentInput: QuoteInput;\n  onUpdateInput: (newInput: QuoteInput) => void;\n  onSimulate: () => void;\n}\n\nexport const QuoteWizard: React.FC<QuoteWizardProps> = ({\n  currentInput,\n  onUpdateInput,\n  onSimulate,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'profile\' | \'beneficiaries\' | \'coverage\' | \'filters\'>(\'profile\');\n  const [isDetectingGps, setIsDetectingGps] = useState(false);\n  const [isSearchingCep, setIsSearchingCep] = useState(false);\n  const [cepField, setCepField] = useState(currentInput.cep || \'\');\n  const [locationMessage, setLocationMessage] = useState<string | null>(null);\n\n  // Helper to update specific fields in currentInput\n  const updateField = <K extends keyof QuoteInput>(key: K, value: QuoteInput[K]) => {\n    onUpdateInput({\n      ...currentInput,\n      [key]: value,\n    });\n  };\n\n  const handleGpsDetect = async () => {\n    setIsDetectingGps(true);\n    setLocationMessage(null);\n    try {\n      const loc = await detectLocationByGps();\n      onUpdateInput({\n        ...currentInput,\n        city: loc.city,\n        state: loc.state,\n        detectedLocation: loc,\n      });\n      setLocationMessage(`Localiza\303\247\303\243o detectada via GPS: ${loc.city}, ${loc.state}`);\n      setTimeout(() => setLocationMessage(null), 4000);\n    } catch (err: any) {\n      setLocationMessage(err.message || \'N\303\243o foi poss\303\255vel obter sinal de GPS.\');\n    } finally {\n      setIsDetectingGps(false);\n    }\n  };\n\n  const handleCepSearch = async (val?: string) => {\n    const raw = (val || cepField).replace(/\\D/g, \'\');\n    if (raw.length !== 8) return;\n\n    setIsSearchingCep(true);\n    setLocationMessage(null);\n    try {\n      const loc = await lookupCep(raw);\n      setCepField(loc.cep || raw);\n      onUpdateInput({\n        ...currentInput,\n        city: loc.city,\n        state: loc.state,\n        cep: loc.cep,\n        detectedLocation: loc,\n      });\n      setLocationMessage(`CEP localizado: ${loc.city}, ${loc.state} ${loc.neighborhood ? `(${loc.neighborhood})` : \'\'}`);\n      setTimeout(() => setLocationMessage(null), 4000);\n    } catch (err: any) {\n      setLocationMessage(err.message || \'CEP n\303\243o encontrado.\');\n    } finally {\n      setIsSearchingCep(false);\n    }\n  };\n\n  const handleCepChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const formatted = formatCep(e.target.value);\n    setCepField(formatted);\n    const digits = e.target.value.replace(/\\D/g, \'\');\n    if (digits.length === 8) {\n      handleCepSearch(digits);\n    }\n  };\n\n  // Add a new beneficiary\n  const handleAddBeneficiary = () => {\n    const defaultAge = 30;\n    const newBeneficiary: Beneficiary = {\n      id: `ben-${Date.now()}-${Math.random().toString(36).substr(2, 4)}`,\n      name: `Dependente ${currentInput.beneficiaries.length}`,\n      relationship: currentInput.beneficiaries.length === 1 ? \'conjuge\' : \'filho\',\n      age: defaultAge,\n      ageBracket: getAnsAgeBracket(defaultAge),\n    };\n\n    onUpdateInput({\n      ...currentInput,\n      beneficiaries: [...currentInput.beneficiaries, newBeneficiary],\n    });\n  };\n\n  // Update a single beneficiary\n  const handleUpdateBeneficiary = (id: string, updates: Partial<Beneficiary>) => {\n    const updated = currentInput.beneficiaries.map((b) => {\n      if (b.id !== id) return b;\n      const newAge = updates.age !== undefined ? Math.max(0, Math.min(110, updates.age)) : b.age;\n      return {\n        ...b,\n        ...updates,\n        age: newAge,\n        ageBracket: getAnsAgeBracket(newAge),\n      };\n    });\n\n    onUpdateInput({\n      ...currentInput,\n      beneficiaries: updated,\n    });\n  };\n\n  // Remove a beneficiary (minimum 1)\n  const handleRemoveBeneficiary = (id: string) => {\n    if (currentInput.beneficiaries.length <= 1) return;\n    onUpdateInput({\n      ...currentInput,\n      beneficiaries: currentInput.beneficiaries.filter((b) => b.id !== id),\n    });\n  };\n\n  // Preset loaders for fast testing\n  const loadPreset = (type: \'jovem\' | \'casal_filho\' | \'familia_senior\' | \'pme\') => {\n    if (type === \'jovem\') {\n      onUpdateInput({\n        ...currentInput,\n        contractType: \'individual\',\n        accommodation: \'enfermaria\',\n        copay: \'com_coparticipacao\',\n        beneficiaries: [\n          { id: \'ben-1\', name: \'Titular\', relationship: \'titular\', age: 26, ageBracket: \'24-28\' },\n        ],\n      });\n    } else if (type === \'casal_filho\') {\n      onUpdateInput({\n        ...currentInput,\n        contractType: \'empresarial\',\n        accommodation: \'apartamento\',\n        copay: \'com_coparticipacao\',\n        beneficiaries: [\n          { id: \'ben-1\', name: \'Titular (S\303\263cio)\', relationship: \'titular\', age: 34, ageBracket: \'34-38\' },\n          { id: \'ben-2\', name: \'C\303\264njuge\', relationship: \'conjuge\', age: 32, ageBracket: \'29-33\' },\n          { id: \'ben-3\', name: \'Filho\', relationship: \'filho\', age: 4, ageBracket: \'00-18\' },\n        ],\n      });\n    } else if (type === \'familia_senior\') {\n      onUpdateInput({\n        ...currentInput,\n        contractType: \'empresarial\',\n        accommodation: \'apartamento\',\n        copay: \'sem_coparticipacao\',\n        beneficiaries: [\n          { id: \'ben-1\', name: \'Titular\', relationship: \'titular\', age: 62, ageBracket: \'59+\' },\n          { id: \'ben-2\', name: \'C\303\264njuge\', relationship: \'conjuge\', age: 58, ageBracket: \'54-58\' },\n        ],\n      });\n    } else if (type === \'pme\') {\n      onUpdateInput({\n        ...currentInput,\n        contractType: \'empresarial\',\n        accommodation: \'enfermaria\',\n        copay: \'com_coparticipacao\',\n        beneficiaries: [\n          { id: \'ben-1\', name: \'Colaborador 1\', relationship: \'titular\', age: 25, ageBracket: \'24-28\' },\n          { id: \'ben-2\', name: \'Colaborador 2\', relationship: \'outro\', age: 31, ageBracket: \'29-33\' },\n          { id: \'ben-3\', name: \'Colaborador 3\', relationship: \'outro\', age: 42, ageBracket: \'39-43\' },\n          { id: \'ben-4\', name: \'Colaborador 4\', relationship: \'outro\', age: 29, ageBracket: \'29-33\' },\n          { id: \'ben-5\', name: \'Colaborador 5\', relationship: \'outro\', age: 36, ageBracket: \'34-38\' },\n          { id: \'ben-6\', name: \'Diretor\', relationship: \'outro\', age: 52, ageBracket: \'49-53\' },\n        ],\n      });\n    }\n  };\n\n  return (\n    <div id=\"simulador\" className=\"bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden\">\n      {/* Header bar of wizard */}\n      <div className=\"p-3.5 sm:p-6 border-b border-slate-100 bg-slate-50/50\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4\">\n          <div>\n            <h2 className=\"text-lg sm:text-xl font-bold font-display text-slate-900\">\n              Configurador Condicional de Cota\303\247\303\243o\n            </h2>\n            <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n              Personalize a modalidade, as vidas e a cobertura para calcular a estimativa m\303\251dia de mercado.\n            </p>\n          </div>\n\n          {/* Quick presets buttons - smooth horizontal touch scroll on mobile */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 -mx-1 px-1\">\n            <span className=\"text-slate-400 font-medium text-[11px] whitespace-nowrap shrink-0\">Exemplos:</span>\n            <button\n              onClick={() => loadPreset(\'jovem\')}\n              className=\"px-2.5 py-1.5 bg-white hover:bg-slate-100 text-slate-700 text-xs rounded-lg border border-slate-200 transition-colors whitespace-nowrap shrink-0 min-h-[36px]\"\n            >\n              Jovem 26 anos\n            </button>\n            <button\n              onClick={() => loadPreset(\'casal_filho\')}\n              className=\"px-2.5 py-1.5 bg-white hover:bg-slate-100 text-teal-700 font-medium text-xs rounded-lg border border-teal-200 transition-colors whitespace-nowrap shrink-0 min-h-[36px]\"\n            >\n              Casal + 1 Filho (MEI)\n            </button>\n            <button\n              onClick={() => loadPreset(\'familia_senior\')}\n              className=\"px-2.5 py-1.5 bg-white hover:bg-slate-100 text-slate-700 text-xs rounded-lg border border-slate-200 transition-colors whitespace-nowrap shrink-0 min-h-[36px]\"\n            >\n              S\303\252nior 59+\n            </button>\n            <button\n              onClick={() => loadPreset(\'pme\')}\n              className=\"px-2.5 py-1.5 bg-white hover:bg-slate-100 text-slate-700 text-xs rounded-lg border border-slate-200 transition-colors whitespace-nowrap shrink-0 min-h-[36px]\"\n            >\n              PME 6 Vidas\n            </button>\n          </div>\n        </div>\n\n        {/* Wizard navigation segmented tabs */}\n        <div className=\"flex items-center gap-1 mt-4 sm:mt-6 p-1 bg-slate-200/70 rounded-xl overflow-x-auto text-xs font-semibold no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'profile\')}\n            className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap shrink-0 min-h-[40px] flex-1 sm:flex-initial ${\n              activeTab === \'profile\'\n                ? \'bg-white text-slate-900 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Building2 className=\"w-3.5 h-3.5 shrink-0\" />\n            <span className=\"sm:hidden\">1. Perfil</span>\n            <span className=\"hidden sm:inline\">1. Tipo de Contrata\303\247\303\243o & Local</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'beneficiaries\')}\n            className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap shrink-0 min-h-[40px] flex-1 sm:flex-initial ${\n              activeTab === \'beneficiaries\'\n                ? \'bg-white text-slate-900 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Users className=\"w-3.5 h-3.5 shrink-0\" />\n            <span className=\"sm:hidden\">2. Vidas ({currentInput.beneficiaries.length})</span>\n            <span className=\"hidden sm:inline\">2. Benefici\303\241rios ({currentInput.beneficiaries.length} vidas)</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'coverage\')}\n            className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap shrink-0 min-h-[40px] flex-1 sm:flex-initial ${\n              activeTab === \'coverage\'\n                ? \'bg-white text-slate-900 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Shield className=\"w-3.5 h-3.5 shrink-0\" />\n            <span className=\"sm:hidden\">3. Cobertura</span>\n            <span className=\"hidden sm:inline\">3. Cobertura & Coparticipa\303\247\303\243o</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'filters\')}\n            className={`flex items-center justify-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap shrink-0 min-h-[40px] flex-1 sm:flex-initial ${\n              activeTab === \'filters\'\n                ? \'bg-white text-slate-900 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Sliders className=\"w-3.5 h-3.5 shrink-0\" />\n            <span className=\"sm:hidden\">4. Filtros</span>\n            <span className=\"hidden sm:inline\">4. Hospitais & Filtros Avan\303\247ados</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Tab Content */}\n      <div className=\"p-3.5 sm:p-6\">\n        {/* TAB 1: Profile & Location */}\n        {activeTab === \'profile\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Modalidade de Contrata\303\247\303\243o\n              </label>\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {/* Empresarial / MEI */}\n                <div\n                  onClick={() => updateField(\'contractType\', \'empresarial\')}\n                  className={`cursor-pointer p-4 rounded-xl border-2 transition-all ${\n                    currentInput.contractType === \'empresarial\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"font-bold text-sm flex items-center gap-2\">\n                      <Building2 className=\"w-4 h-4 text-teal-600\" />\n                      Empresarial / MEI (CNPJ)\n                    </span>\n                    <span className=\"text-[11px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded\">\n                      At\303\251 35% OFF\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-slate-500 leading-relaxed\">\n                    V\303\241lido para MEI, Eireli, LTDA ou grandes empresas a partir de 1 ou 2 vidas (titular + dependente).\n                  </p>\n                </div>\n\n                {/* Individual / Familiar */}\n                <div\n                  onClick={() => updateField(\'contractType\', \'individual\')}\n                  className={`cursor-pointer p-4 rounded-xl border-2 transition-all ${\n                    currentInput.contractType === \'individual\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"font-bold text-sm flex items-center gap-2\">\n                      <User className=\"w-4 h-4 text-teal-600\" />\n                      Individual / Familiar (CPF)\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-slate-500 leading-relaxed\">\n                    Pessoa f\303\255sica com reajuste anual controlado diretamente pela ANS. Sem necessidade de v\303\255nculo ou empresa.\n                  </p>\n                </div>\n\n                {/* Coletivo por Ades\303\243o */}\n                <div\n                  onClick={() => updateField(\'contractType\', \'adesao\')}\n                  className={`cursor-pointer p-4 rounded-xl border-2 transition-all ${\n                    currentInput.contractType === \'adesao\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"font-bold text-sm flex items-center gap-2\">\n                      <Users className=\"w-4 h-4 text-teal-600\" />\n                      Coletivo por Ades\303\243o\n                    </span>\n                    <span className=\"text-[11px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded\">\n                      ~18% OFF\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-slate-500 leading-relaxed\">\n                    Para profissionais liberais vinculados a sindicatos ou conselhos (OAB, CREA, CRM, estudantes UNE, etc.).\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Location selector with CEP & GPS precision */}\n            <div className=\"pt-5 border-t border-slate-100 space-y-4\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-800 uppercase tracking-wider\">\n                    Identifica\303\247\303\243o de Localiza\303\247\303\243o & CEP\n                  </label>\n                  <p className=\"text-xs text-slate-500\">\n                    A precifica\303\247\303\243o e a disponibilidade de rede hospitalar dependem do seu Estado e Cidade.\n                  </p>\n                </div>\n\n                {/* Instant GPS button */}\n                <button\n                  type=\"button\"\n                  onClick={handleGpsDetect}\n                  disabled={isDetectingGps}\n                  className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-semibold rounded-lg transition-colors border border-teal-200 shrink-0 self-start sm:self-auto\"\n                >\n                  {isDetectingGps ? (\n                    <>\n                      <Loader2 className=\"w-3.5 h-3.5 animate-spin\" />\n                      <span>Detectando GPS...</span>\n                    </>\n                  ) : (\n                    <>\n                      <Crosshair className=\"w-3.5 h-3.5 text-teal-600\" />\n                      <span>Detectar Minha Localiza\303\247\303\243o (GPS)</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              {locationMessage && (\n                <div className=\"p-2.5 rounded-lg bg-teal-50 border border-teal-200 text-xs text-teal-900 flex items-center gap-2\">\n                  <CheckCircle2 className=\"w-4 h-4 text-teal-600 shrink-0\" />\n                  <span>{locationMessage}</span>\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-3\">\n                {/* CEP input */}\n                <div className=\"sm:col-span-4\">\n                  <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                    Buscar por CEP\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"text\"\n                      value={cepField}\n                      onChange={handleCepChange}\n                      placeholder=\"00000-000\"\n                      maxLength={9}\n                      className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-mono text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={() => handleCepSearch()}\n                      disabled={isSearchingCep}\n                      className=\"absolute right-2 top-2 text-slate-400 hover:text-teal-700\"\n                      title=\"Localizar CEP\"\n                    >\n                      {isSearchingCep ? (\n                        <Loader2 className=\"w-4 h-4 animate-spin text-teal-600\" />\n                      ) : (\n                        <Search className=\"w-4 h-4\" />\n                      )}\n                    </button>\n                  </div>\n                  <span className=\"text-[10px] text-slate-400 mt-0.5 block\">\n                    Preenche cidade e estado automaticamente\n                  </span>\n                </div>\n\n                {/* State selector */}\n                <div className=\"sm:col-span-4\">\n                  <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                    Estado (UF)\n                  </label>\n                  <div className=\"relative\">\n                    <MapPin className=\"w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5\" />\n                    <select\n                      value={currentInput.state}\n                      onChange={(e) => updateField(\'state\', e.target.value)}\n                      className=\"w-full pl-8 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                    >\n                      {BRAZILIAN_STATES.map((st) => (\n                        <option key={st.uf} value={st.uf}>\n                          {st.uf} - {st.name}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n                </div>\n\n                {/* City input */}\n                <div className=\"sm:col-span-4\">\n                  <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                    Cidade\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={currentInput.city}\n                    onChange={(e) => updateField(\'city\', e.target.value)}\n                    placeholder=\"Ex: S\303\243o Paulo, Rio de Janeiro...\"\n                    className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 min-h-[40px]\"\n                  />\n                </div>\n              </div>\n\n              {/* Step Navigation to Next Tab */}\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  type=\"button\"\n                  onClick={() => setActiveTab(\'beneficiaries\')}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors min-h-[44px]\"\n                >\n                  <span>Avan\303\247ar para Vidas & Idades ({currentInput.beneficiaries.length})</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 2: Beneficiaries & Ages */}\n        {activeTab === \'beneficiaries\' && (\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h3 className=\"text-sm font-bold text-slate-900\">\n                  Benefici\303\241rios do Plano ({currentInput.beneficiaries.length} vidas)\n                </h3>\n                <p className=\"text-xs text-slate-500\">\n                  A cota\303\247\303\243o \303\251 calculada vida a vida com base nas 10 faixas et\303\241rias regulamentadas pela ANS.\n                </p>\n              </div>\n              <button\n                onClick={handleAddBeneficiary}\n                className=\"inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-teal-700 bg-teal-50 hover:bg-teal-100 rounded-lg transition-colors border border-teal-200\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Adicionar Dependente</span>\n              </button>\n            </div>\n\n            {/* List of Beneficiaries */}\n            <div className=\"space-y-3\">\n              {currentInput.beneficiaries.map((b, idx) => {\n                const bracket = getAnsAgeBracket(b.age);\n                const bracketFactor = ANS_BRACKET_FACTORS[bracket];\n\n                return (\n                  <div\n                    key={b.id}\n                    className=\"p-3.5 sm:p-4 rounded-xl border border-slate-200 bg-slate-50/60 space-y-3\"\n                  >\n                    <div className=\"flex items-center justify-between gap-2\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className=\"w-6 h-6 rounded-full bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center shrink-0\">\n                          {idx + 1}\n                        </div>\n                        <span className=\"font-semibold text-xs text-slate-800\">\n                          {b.name || `Benefici\303\241rio ${idx + 1}`}\n                        </span>\n                      </div>\n\n                      {currentInput.beneficiaries.length > 1 && (\n                        <button\n                          type=\"button\"\n                          onClick={() => handleRemoveBeneficiary(b.id)}\n                          title=\"Remover benefici\303\241rio\"\n                          className=\"p-1.5 text-slate-400 hover:text-rose-600 rounded-lg transition-colors min-h-[32px] min-w-[32px] flex items-center justify-center\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      )}\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center\">\n                      <div className=\"sm:col-span-4\">\n                        <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                          Nome / Identifica\303\247\303\243o\n                        </label>\n                        <input\n                          type=\"text\"\n                          value={b.name}\n                          onChange={(e) =>\n                            handleUpdateBeneficiary(b.id, { name: e.target.value })\n                          }\n                          placeholder=\"Ex: Titular, Esposa...\"\n                          className=\"w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                        />\n                      </div>\n\n                      <div className=\"sm:col-span-3\">\n                        <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                          Parentesco\n                        </label>\n                        <select\n                          value={b.relationship}\n                          onChange={(e) =>\n                            handleUpdateBeneficiary(b.id, {\n                              relationship: e.target.value as any,\n                            })\n                          }\n                          className=\"w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                        >\n                          <option value=\"titular\">Titular</option>\n                          <option value=\"conjuge\">C\303\264njuge / Parceiro(a)</option>\n                          <option value=\"filho\">Filho(a) / Dependente</option>\n                          <option value=\"pais\">Pai / M\303\243e</option>\n                          <option value=\"outro\">Outro dependente</option>\n                        </select>\n                      </div>\n\n                      <div className=\"sm:col-span-3\">\n                        <label className=\"text-[10px] font-semibold text-slate-500 uppercase block mb-1\">\n                          Idade (anos)\n                        </label>\n                        <div className=\"flex items-center gap-1\">\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              handleUpdateBeneficiary(b.id, {\n                                age: Math.max(0, b.age - 1),\n                              })\n                            }\n                            className=\"w-9 h-9 rounded-lg bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm shrink-0 transition-colors\"\n                            aria-label=\"Diminuir idade\"\n                          >\n                            <Minus className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <input\n                            type=\"number\"\n                            min=\"0\"\n                            max=\"110\"\n                            value={b.age}\n                            onChange={(e) =>\n                              handleUpdateBeneficiary(b.id, {\n                                age: parseInt(e.target.value, 10) || 0,\n                              })\n                            }\n                            className=\"w-full px-2 py-2 bg-white border border-slate-200 rounded-lg text-xs font-mono font-semibold text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 text-center min-h-[36px]\"\n                          />\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              handleUpdateBeneficiary(b.id, {\n                                age: Math.min(110, b.age + 1),\n                              })\n                            }\n                            className=\"w-9 h-9 rounded-lg bg-slate-100 hover:bg-slate-200 active:bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm shrink-0 transition-colors\"\n                            aria-label=\"Aumentar idade\"\n                          >\n                            <Plus className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n                      </div>\n\n                      <div className=\"sm:col-span-2 bg-white p-2 rounded-lg border border-slate-200 flex items-center justify-between sm:flex-col sm:items-start\">\n                        <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">Faixa ANS</span>\n                        <span className=\"text-xs font-semibold text-slate-800\">\n                          {getAnsAgeBracketLabel(bracket)}\n                        </span>\n                        <span className=\"text-[10px] text-teal-600 font-mono\">\n                          Fator {bracketFactor.toFixed(2)}x\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n\n            <div className=\"p-3 bg-amber-50 rounded-xl border border-amber-200/80 text-xs text-amber-900 flex items-start gap-2.5\">\n              <Info className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n              <p>\n                <strong>Regra ANS RN 563:</strong> A varia\303\247\303\243o acumulada entre a 7\302\252 e a 10\302\252 faixa et\303\241ria\n                n\303\243o pode ser superior \303\240 varia\303\247\303\243o acumulada entre a 1\302\252 e a 7\302\252 faixa, e a \303\272ltima faixa (59+)\n                n\303\243o pode ser mais do que 6 vezes o valor da primeira (0 a 18 anos).\n              </p>\n            </div>\n\n            {/* Step Navigation to Next Tab */}\n            <div className=\"pt-2 flex items-center justify-between gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'profile\')}\n                className=\"inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition-colors min-h-[44px]\"\n              >\n                <ArrowLeft className=\"w-4 h-4\" />\n                <span>Voltar</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'coverage\')}\n                className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-xl shadow-xs transition-colors min-h-[44px]\"\n              >\n                <span>Avan\303\247ar para Cobertura</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 3: Coverage, Accommodation & Copay */}\n        {activeTab === \'coverage\' && (\n          <div className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n              {/* Acomoda\303\247\303\243o */}\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Tipo de Acomoda\303\247\303\243o em Interna\303\247\303\243o\n                </label>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <div\n                    onClick={() => updateField(\'accommodation\', \'enfermaria\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.accommodation === \'enfermaria\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-sm mb-1\">Enfermaria</div>\n                    <p className=\"text-xs text-slate-500\">\n                      Quarto coletivo (2 a 4 leitos). Menor custo mensal (econ\303\264mico).\n                    </p>\n                  </div>\n\n                  <div\n                    onClick={() => updateField(\'accommodation\', \'apartamento\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.accommodation === \'apartamento\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-sm mb-1\">Apartamento</div>\n                    <p className=\"text-xs text-slate-500\">\n                      Quarto individual com banheiro privativo e acompanhante 24h.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Coparticipa\303\247\303\243o */}\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Modelo de Coparticipa\303\247\303\243o\n                </label>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  <div\n                    onClick={() => updateField(\'copay\', \'com_coparticipacao\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.copay === \'com_coparticipacao\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-1\">\n                      <span className=\"font-bold text-sm\">Com Coparticipa\303\247\303\243o</span>\n                      <span className=\"text-[10px] font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded\">\n                        -24%\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-slate-500\">\n                      Mensalidade mais barata. Pequena taxa apenas ao usar consultas/exames.\n                    </p>\n                  </div>\n\n                  <div\n                    onClick={() => updateField(\'copay\', \'sem_coparticipacao\')}\n                    className={`cursor-pointer p-3.5 sm:p-4 rounded-xl border-2 transition-all ${\n                      currentInput.copay === \'sem_coparticipacao\'\n                        ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                        : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-sm mb-1\">Sem Coparticipa\303\247\303\243o</div>\n                    <p className=\"text-xs text-slate-500\">\n                      Mensalidade fixa total. Custo zero ao consultar m\303\251dicos ou realizar exames.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Abrang\303\252ncia Geogr\303\241fica */}\n            <div className=\"pt-4 border-t border-slate-100\">\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Abrang\303\252ncia Geogr\303\241fica\n              </label>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div\n                  onClick={() => updateField(\'coverageArea\', \'regional\')}\n                  className={`cursor-pointer p-3.5 rounded-xl border-2 transition-all ${\n                    currentInput.coverageArea === \'regional\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs mb-0.5\">Regional / Grupo de Munic\303\255pios</div>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Focado na sua regi\303\243o metropolitana e cidades vizinhas. Maior custo-benef\303\255cio.\n                  </p>\n                </div>\n\n                <div\n                  onClick={() => updateField(\'coverageArea\', \'nacional\')}\n                  className={`cursor-pointer p-3.5 rounded-xl border-2 transition-all ${\n                    currentInput.coverageArea === \'nacional\'\n                      ? \'border-teal-600 bg-teal-50/40 text-teal-950\'\n                      : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                  }`}\n                >\n                  <div className=\"font-bold text-xs mb-0.5\">Nacional (Todo o Brasil)</div>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Atendimento eletivo e de urg\303\252ncia em qualquer estado da federa\303\247\303\243o.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 4: Reference Hospitals & Advanced Filters */}\n        {activeTab === \'filters\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                Filtrar por Hospitais de Excel\303\252ncia Desejados (Opcional)\n              </label>\n              <p className=\"text-xs text-slate-500 mb-3\">\n                Selecione os hospitais que voc\303\252 faz quest\303\243o que estejam credenciados:\n              </p>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2\">\n                {REFERENCE_HOSPITALS.slice(0, 9).map((h) => {\n                  const isSelected = (currentInput.selectedHospitals || []).includes(h.name);\n                  return (\n                    <button\n                      key={h.name}\n                      onClick={() => {\n                        const current = currentInput.selectedHospitals || [];\n                        const updated = isSelected\n                          ? current.filter((item) => item !== h.name)\n                          : [...current, h.name];\n                        updateField(\'selectedHospitals\', updated);\n                      }}\n                      className={`text-left p-2.5 rounded-lg border text-xs transition-all ${\n                        isSelected\n                          ? \'border-teal-600 bg-teal-50 text-teal-900 font-semibold\'\n                          : \'border-slate-200 hover:border-slate-300 text-slate-700\'\n                      }`}\n                    >\n                      <div className=\"truncate\">{h.name}</div>\n                      <div className=\"text-[10px] text-slate-400\">\n                        {h.city} \302\267 {h.tier === \'excelencia\' ? \'N\303\255vel A\' : \'Refer\303\252ncia\'}\n                      </div>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100\">\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Filtrar por Operadora\n                </label>\n                <select\n                  value={currentInput.operatorFilter || \'all\'}\n                  onChange={(e) => updateField(\'operatorFilter\', e.target.value)}\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                >\n                  <option value=\"all\">Todas as Operadoras</option>\n                  <option value=\"bradesco\">Bradesco Sa\303\272de</option>\n                  <option value=\"amil\">Amil Sa\303\272de</option>\n                  <option value=\"sulamerica\">SulAm\303\251rica Sa\303\272de</option>\n                  <option value=\"gndi\">NotreDame Interm\303\251dica (GNDI)</option>\n                  <option value=\"unimed\">Unimed</option>\n                  <option value=\"portoseguro\">Porto Seguro Sa\303\272de</option>\n                  <option value=\"alice\">Alice</option>\n                  <option value=\"hapvida\">Hapvida</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">\n                  Teto M\303\241ximo Mensal Desejado (R$)\n                </label>\n                <input\n                  type=\"number\"\n                  placeholder=\"Ex: 1500 (Deixe em branco para sem limite)\"\n                  value={currentInput.maxMonthlyBudget || \'\'}\n                  onChange={(e) =>\n                    updateField(\n                      \'maxMonthlyBudget\',\n                      e.target.value ? parseFloat(e.target.value) : undefined\n                    )\n                  }\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 font-mono\"\n                />\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Footer action bar */}\n      <div className=\"p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3\">\n        <div className=\"text-xs text-slate-500\">\n          Total de vidas configuradas:{\' \'}\n          <strong className=\"text-slate-900\">{currentInput.beneficiaries.length} vidas</strong> em{\' \'}\n          <strong className=\"text-slate-900\">{currentInput.state}</strong> (\n          {currentInput.contractType === \'empresarial\'\n            ? \'Empresarial / MEI\'\n            : currentInput.contractType === \'adesao\'\n            ? \'Ades\303\243o\'\n            : \'Individual PF\'}\n          ).\n        </div>\n\n        <button\n          onClick={onSimulate}\n          className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs rounded-lg transition-colors shadow-sm\"\n        >\n          <span>Atualizar Estimativas & Compara\303\247\303\243o</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 920
    num_bytes: 42907
  }
}
