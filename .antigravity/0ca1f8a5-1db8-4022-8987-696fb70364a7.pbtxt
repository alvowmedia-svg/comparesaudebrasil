        target_content: "      {/* Main Container */}\n      <main className=\"flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10\">\n        {/* Dynamic Location Precision Bar */}\n        <LocationDetectorBar\n          currentInput={quoteInput}\n          onLocationChange={handleLocationChange}\n        />\n\n        {/* Interactive Quote Wizard */}\n        <QuoteWizard\n          currentInput={quoteInput}\n          onUpdateInput={setQuoteInput}\n          onSimulate={() => scrollTo(\'comparador\')}\n        />\n\n        {/* COMPARISON RESULTS SECTION */}\n        <section id=\"comparador\" className=\"space-y-6 pt-4\">\n          {/* Results Summary Bar */}\n          <div className=\"bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h2 className=\"text-xl font-bold font-display text-slate-900\">\n                  Planos Dispon\303\255veis ({displayedQuotes.length} op\303\247\303\265es encontradas)\n                </h2>\n                <span className=\"text-xs text-slate-400\">\302\267</span>\n                <span className=\"text-xs text-slate-500\">\n                  {quoteInput.state} ({quoteInput.beneficiaries.length} vidas)\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Estimativas mensais calculadas considerando modalidade{\' \'}\n                <strong className=\"text-slate-800\">\n                  {quoteInput.contractType === \'empresarial\'\n                    ? \'Empresarial MEI/PME\'\n                    : quoteInput.contractType === \'adesao\'\n                    ? \'Ades\303\243o\'\n                    : \'Individual\'}\n                </strong>{\' \'}\n                e acomoda\303\247\303\243o <strong className=\"text-slate-800 capitalize\">{quoteInput.accommodation}</strong>.\n              </p>\n            </div>\n\n            {/* Controls: Segmented Tier Filters & Sort */}\n            <div className=\"flex flex-wrap items-center gap-3\">\n              {/* Category Segmented Tabs */}\n              <div className=\"flex items-center p-1 bg-slate-100 rounded-lg text-xs font-medium\">\n                <button\n                  onClick={() => setTierFilter(\'all\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'all\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Todos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'economico\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'economico\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Econ\303\264micos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'intermediario\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'intermediario\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Intermedi\303\241rios\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'premium\')}\n                  className={`px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${\n                    tierFilter === \'premium\'\n                      ? \'bg-white text-slate-900 shadow-sm font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Premium\n                </button>\n              </div>\n\n              {/* Sort Dropdown */}\n              <div className=\"flex items-center gap-1.5 text-xs text-slate-600\">\n                <ArrowUpDown className=\"w-3.5 h-3.5 text-slate-400\" />\n                <select\n                  value={sortBy}\n                  onChange={(e) => setSortBy(e.target.value as any)}\n                  className=\"px-2.5 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 font-medium\"\n                >\n                  <option value=\"price_asc\">Menor Pre\303\247o Mensal</option>\n                  <option value=\"price_desc\">Maior Pre\303\247o Mensal</option>\n                  <option value=\"ans_score\">Maior Nota ANS (IDSS)</option>\n                  <option value=\"reimbursement\">Maior Reembolso</option>\n                </select>\n              </div>\n            </div>\n          </div>"
        replacement_content: "      {/* Main Container */}\n      <main className=\"flex-1 max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 md:pb-10 space-y-8 sm:space-y-10\">\n        {/* Dynamic Location Precision Bar */}\n        <LocationDetectorBar\n          currentInput={quoteInput}\n          onLocationChange={handleLocationChange}\n        />\n\n        {/* Interactive Quote Wizard */}\n        <QuoteWizard\n          currentInput={quoteInput}\n          onUpdateInput={setQuoteInput}\n          onSimulate={() => scrollTo(\'comparador\')}\n        />\n\n        {/* COMPARISON RESULTS SECTION */}\n        <section id=\"comparador\" className=\"space-y-6 pt-4\">\n          {/* Results Summary Bar */}\n          <div className=\"bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n            <div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                <h2 className=\"text-lg sm:text-xl font-bold font-display text-slate-900\">\n                  Planos Dispon\303\255veis ({displayedQuotes.length} op\303\247\303\265es)\n                </h2>\n                <span className=\"text-xs text-slate-400\">\302\267</span>\n                <span className=\"text-xs text-slate-500 font-medium\">\n                  {quoteInput.state} ({quoteInput.beneficiaries.length} vidas)\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Estimativas mensais calculadas considerando modalidade{\' \'}\n                <strong className=\"text-slate-800\">\n                  {quoteInput.contractType === \'empresarial\'\n                    ? \'Empresarial MEI/PME\'\n                    : quoteInput.contractType === \'adesao\'\n                    ? \'Ades\303\243o\'\n                    : \'Individual\'}\n                </strong>{\' \'}\n                e acomoda\303\247\303\243o <strong className=\"text-slate-800 capitalize\">{quoteInput.accommodation}</strong>.\n              </p>\n            </div>\n\n            {/* Controls: Segmented Tier Filters & Sort - mobile scrollable */}\n            <div className=\"flex flex-col sm:flex-row sm:items-center gap-2.5 w-full lg:w-auto\">\n              {/* Category Segmented Tabs */}\n              <div className=\"flex items-center p-1 bg-slate-100 rounded-xl text-xs font-medium overflow-x-auto no-scrollbar max-w-full\">\n                <button\n                  onClick={() => setTierFilter(\'all\')}\n                  className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap min-h-[38px] ${\n                    tierFilter === \'all\'\n                      ? \'bg-white text-slate-900 shadow-xs font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Todos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'economico\')}\n                  className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap min-h-[38px] ${\n                    tierFilter === \'economico\'\n                      ? \'bg-white text-slate-900 shadow-xs font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Econ\303\264micos\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'intermediario\')}\n                  className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap min-h-[38px] ${\n                    tierFilter === \'intermediario\'\n                      ? \'bg-white text-slate-900 shadow-xs font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Intermedi\303\241rios\n                </button>\n                <button\n                  onClick={() => setTierFilter(\'premium\')}\n                  className={`px-3 py-2 rounded-lg transition-colors whitespace-nowrap min-h-[38px] ${\n                    tierFilter === \'premium\'\n                      ? \'bg-white text-slate-900 shadow-xs font-semibold\'\n                      : \'text-slate-600 hover:text-slate-900\'\n                  }`}\n                >\n                  Premium\n                </button>\n              </div>\n\n              {/* Sort Dropdown */}\n              <div className=\"flex items-center gap-1.5 text-xs text-slate-600 w-full sm:w-auto\">\n                <ArrowUpDown className=\"w-3.5 h-3.5 text-slate-400 shrink-0\" />\n                <select\n                  value={sortBy}\n                  onChange={(e) => setSortBy(e.target.value as any)}\n                  className=\"w-full sm:w-auto px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-teal-500 font-medium min-h-[40px]\"\n                >\n                  <option value=\"price_asc\">Menor Pre\303\247o Mensal</option>\n                  <option value=\"price_desc\">Maior Pre\303\247o Mensal</option>\n                  <option value=\"ans_score\">Maior Nota ANS (IDSS)</option>\n                  <option value=\"reimbursement\">Maior Reembolso</option>\n                </select>\n              </div>\n            </div>\n          </div>"
