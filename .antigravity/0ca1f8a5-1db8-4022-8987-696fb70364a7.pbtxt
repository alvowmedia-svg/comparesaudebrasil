    content: "import React from \'react\';\nimport { Activity, ShieldCheck } from \'lucide-react\';\n\nexport const Footer: React.FC = () => {\n  return (\n    <footer className=\"bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          {/* Brand */}\n          <div className=\"space-y-2\">\n            <div className=\"text-white font-bold font-display text-lg flex items-center gap-2\">\n              <span className=\"w-7 h-7 rounded-lg bg-teal-600 text-white flex items-center justify-center font-bold text-xs\">\n                <Activity className=\"w-4 h-4 text-white\" />\n              </span>\n              <span>ComparaSa\303\272de Brasil</span>\n            </div>\n            <p className=\"text-slate-400 text-xs max-w-sm\">\n              Plataforma de intelig\303\252ncia comparativa e cota\303\247\303\243o de planos de sa\303\272de no Brasil.\n            </p>\n          </div>\n\n          {/* Links */}\n          <div className=\"flex flex-wrap gap-6 text-xs text-slate-300\">\n            <a href=\"#simulador\" className=\"hover:text-white transition-colors\">\n              Simulador de Cota\303\247\303\243o\n            </a>\n            <a href=\"#comparador\" className=\"hover:text-white transition-colors\">\n              Tabela Comparativa\n            </a>\n            <a href=\"#hospitais\" className=\"hover:text-white transition-colors\">\n              Rede Hospitalar\n            </a>\n            <a href=\"#regras-ans\" className=\"hover:text-white transition-colors\">\n              Regras & Car\303\252ncias ANS\n            </a>\n            <a href=\"#faq\" className=\"hover:text-white transition-colors\">\n              Perguntas Frequentes\n            </a>\n          </div>\n        </div>\n\n        {/* Regulatory Disclaimer */}\n        <div className=\"pt-6 border-t border-slate-800 text-[11px] leading-relaxed text-slate-500 space-y-2\">\n          <p>\n            <strong>Aviso Regulat\303\263rio e Legal:</strong> O ComparaSa\303\272de Brasil \303\251 um simulador anal\303\255tico independente de mercado. Todas as estimativas de pre\303\247o apresentadas s\303\243o calculadas a partir de par\303\242metros estat\303\255sticos, tabelas referenciais de mercado e as 10 faixas et\303\241rias estipuladas pela Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS) segundo a Resolu\303\247\303\243o Normativa RN n\302\272 563 e Lei Federal n\302\272 9.656/1998. Os valores reais finais podem variar conforme aprova\303\247\303\243o cadastral, valida\303\247\303\243o de elegibilidade (CPF/CNPJ), vig\303\252ncia de tabela e declara\303\247\303\243o de sa\303\272de.\n          </p>\n          <div className=\"flex items-center gap-3 text-slate-400\">\n            <span>ANS - Ag\303\252ncia Nacional de Sa\303\272de Suplementar</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\303\215ndice IDSS Atualizado</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Diretrizes de Utiliza\303\247\303\243o (DUT)</span>\n          </div>\n        </div>\n\n        {/* Copyright */}\n        <div className=\"pt-4 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-500\">\n          <div>\n            \302\251 {new Date().getFullYear()} ComparaSa\303\272de Brasil. Todos os direitos reservados.\n          </div>\n          <div>\n            Desenvolvido com foco em alta performance e conformidade atuarial.\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { Activity, ShieldCheck } from \'lucide-react\';\n\nexport const Footer: React.FC = () => {\n  return (\n    <footer className=\"bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          {/* Brand */}\n          <div className=\"space-y-2\">\n            <div className=\"text-white font-bold font-display text-lg flex items-center gap-2\">\n              <span className=\"w-7 h-7 rounded-lg bg-teal-600 text-white flex items-center justify-center font-bold text-xs\">\n                <Activity className=\"w-4 h-4 text-white\" />\n              </span>\n              <span>ComparaSa\303\272de Brasil</span>\n            </div>\n            <p className=\"text-slate-400 text-xs max-w-sm\">\n              Plataforma de intelig\303\252ncia comparativa e cota\303\247\303\243o de planos de sa\303\272de no Brasil.\n            </p>\n          </div>\n\n          {/* Links */}\n          <div className=\"flex flex-wrap gap-6 text-xs text-slate-300\">\n            <a href=\"#simulador\" className=\"hover:text-white transition-colors\">\n              Simulador de Cota\303\247\303\243o\n            </a>\n            <a href=\"#comparador\" className=\"hover:text-white transition-colors\">\n              Tabela Comparativa\n            </a>\n            <a href=\"#hospitais\" className=\"hover:text-white transition-colors\">\n              Rede Hospitalar\n            </a>\n            <a href=\"#regras-ans\" className=\"hover:text-white transition-colors\">\n              Regras & Car\303\252ncias ANS\n            </a>\n            <a href=\"#faq\" className=\"hover:text-white transition-colors\">\n              Perguntas Frequentes\n            </a>\n          </div>\n        </div>\n\n        {/* Regulatory Disclaimer */}\n        <div className=\"pt-6 border-t border-slate-800 text-[11px] leading-relaxed text-slate-500 space-y-2\">\n          <p>\n            <strong>Aviso Regulat\303\263rio e Legal:</strong> O ComparaSa\303\272de Brasil \303\251 um simulador anal\303\255tico independente de mercado. Todas as estimativas de pre\303\247o apresentadas s\303\243o calculadas a partir de par\303\242metros estat\303\255sticos, tabelas referenciais de mercado e as 10 faixas et\303\241rias estipuladas pela Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS) segundo a Resolu\303\247\303\243o Normativa RN n\302\272 563 e Lei Federal n\302\272 9.656/1998. Os valores reais finais podem variar conforme aprova\303\247\303\243o cadastral, valida\303\247\303\243o de elegibilidade (CPF/CNPJ), vig\303\252ncia de tabela e declara\303\247\303\243o de sa\303\272de.\n          </p>\n          <div className=\"flex items-center gap-3 text-slate-400\">\n            <span>ANS - Ag\303\252ncia Nacional de Sa\303\272de Suplementar</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\303\215ndice IDSS Atualizado</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Diretrizes de Utiliza\303\247\303\243o (DUT)</span>\n          </div>\n        </div>\n\n        {/* Copyright */}\n        <div className=\"pt-4 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-500\">\n          <div>\n            \302\251 {new Date().getFullYear()} ComparaSa\303\272de Brasil. Todos os direitos reservados.\n          </div>\n          <div>\n            Desenvolvido com foco em alta performance e conformidade atuarial.\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
