    content: "import React, { useState } from \'react\';\nimport { ChevronDown, ChevronUp, HelpCircle, ShieldAlert, FileText, CheckCircle2 } from \'lucide-react\';\n\ninterface FaqItem {\n  question: string;\n  answer: string;\n  category: string;\n}\n\nexport const FaqSection: React.FC = () => {\n  const [openIndex, setOpenIndex] = useState<number | null>(0);\n\n  const faqs: FaqItem[] = [\n    {\n      question: \'Como funciona a l\303\263gica de c\303\241lculo das 10 faixas et\303\241rias da ANS?\',\n      category: \'Regulamenta\303\247\303\243o ANS\',\n      answer:\n        \'A Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS) divide os benefici\303\241rios em exatamente 10 faixas et\303\241rias obrigat\303\263rias (0 a 18 anos at\303\251 59 anos ou mais). Pela Resolu\303\247\303\243o Normativa RN 563, a varia\303\247\303\243o de pre\303\247o acumulada entre a 7\302\252 e a 10\302\252 faixa n\303\243o pode superar a varia\303\247\303\243o entre a 1\302\252 e a 7\302\252 faixa, e o valor da \303\272ltima faixa (59+) n\303\243o pode ultrapassar 6 vezes o valor da primeira (0 a 18 anos). Nosso algoritmo replica com exatid\303\243o essa curva atuarial.\',\n    },\n    {\n      question: \'Por que planos empresariais (MEI/PME) chegam a ser at\303\251 35% mais baratos?\',\n      category: \'Economia & Contrata\303\247\303\243o\',\n      answer:\n        \'Operadoras consideram o risco atuarial dilu\303\255do em grupos corporativos e o custo de inadimpl\303\252ncia menor em contratos vinculados a pessoa jur\303\255dica (CNPJ). Com um MEI aberto h\303\241 pelo menos 6 meses, j\303\241 \303\251 poss\303\255vel contratar a partir de 1 vida (titular) ou 2 vidas (titular + dependente), garantindo a mesma rede credenciada de hospitais e m\303\251dicos por uma mensalidade significativamente inferior.\',\n    },\n    {\n      question: \'O que \303\251 a Coparticipa\303\247\303\243o e quando ela \303\251 recomendada?\',\n      category: \'Modalidade\',\n      answer:\n        \'Na coparticipa\303\247\303\243o, voc\303\252 tem uma redu\303\247\303\243o imediata de 20% a 26% na mensalidade fixa todo m\303\252s. Em troca, quando realiza uma consulta m\303\251dica simples ou exame b\303\241sico, paga uma pequena taxa (geralmente entre R$ 25 e R$ 40 por consulta). Para pessoas e fam\303\255lias com frequ\303\252ncia moderada de utiliza\303\247\303\243o, a economia anual acumulada na mensalidade costuma superar com folga o que \303\251 gasto em coparticipa\303\247\303\265es.\',\n    },\n    {\n      question: \'Quais s\303\243o os prazos m\303\241ximos de car\303\252ncia da ANS?\',\n      category: \'Car\303\252ncias\',\n      answer:\n        \'Pela Lei 9.656/98, os limites legais inultrapass\303\241veis s\303\243o: 24 horas para urg\303\252ncia e emerg\303\252ncia com risco de vida; 30 dias para consultas m\303\251dicas e exames laboratoriais b\303\241sicos; 180 dias para exames especiais, terapias, cirurgias e interna\303\247\303\265es cl\303\255nicas; 300 dias para parto a termo (a partir de 37 semanas); e 24 meses de Cobertura Parcial Tempor\303\241ria (CPT) para doen\303\247as preexistentes declaradas na ades\303\243o.\',\n    },\n    {\n      question: \'Como funciona a Portabilidade de Car\303\252ncias da ANS?\',\n      category: \'Car\303\252ncias & Troca\',\n      answer:\n        \'Se voc\303\252 j\303\241 possui um plano de sa\303\272de h\303\241 pelo menos 2 anos (ou 3 anos caso tenha cumprido CPT) e est\303\241 em dia com as mensalidades, a ANS garante o direito \303\240 portabilidade especial para outro plano de faixa de pre\303\247o compat\303\255vel sem necessidade de cumprir qualquer car\303\252ncia novamente.\',\n    },\n    {\n      question: \'O plano de sa\303\272de \303\251 dedut\303\255vel no Imposto de Renda (IRPF)?\',\n      category: \'Tributa\303\247\303\243o & Benef\303\255cio Fiscal\',\n      answer:\n        \'Sim! Despesas com planos de sa\303\272de para voc\303\252 e seus dependentes legais s\303\243o 100% dedut\303\255veis no Imposto de Renda da Pessoa F\303\255sica (modelo completo), sem qualquer limite de teto anual. Quem est\303\241 na al\303\255quota de 27,5% recupera mais de um quarto de todo o investimento anual em sa\303\272de na restitui\303\247\303\243o ou abatimento do imposto devido.\',\n    },\n  ];\n\n  return (\n    <section id=\"faq\" className=\"py-16 bg-white border-t border-slate-200\">\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        {/* Section Header */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"text-xs font-semibold text-teal-700 uppercase tracking-wider\">\n            Tire Suas D\303\272vidas\n          </div>\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-display text-slate-900 tracking-tight\">"
    raw_content: "import React, { useState } from \'react\';\nimport { ChevronDown, ChevronUp, HelpCircle, ShieldAlert, FileText, CheckCircle2 } from \'lucide-react\';\n\ninterface FaqItem {\n  question: string;\n  answer: string;\n  category: string;\n}\n\nexport const FaqSection: React.FC = () => {\n  const [openIndex, setOpenIndex] = useState<number | null>(0);\n\n  const faqs: FaqItem[] = [\n    {\n      question: \'Como funciona a l\303\263gica de c\303\241lculo das 10 faixas et\303\241rias da ANS?\',\n      category: \'Regulamenta\303\247\303\243o ANS\',\n      answer:\n        \'A Ag\303\252ncia Nacional de Sa\303\272de Suplementar (ANS) divide os benefici\303\241rios em exatamente 10 faixas et\303\241rias obrigat\303\263rias (0 a 18 anos at\303\251 59 anos ou mais). Pela Resolu\303\247\303\243o Normativa RN 563, a varia\303\247\303\243o de pre\303\247o acumulada entre a 7\302\252 e a 10\302\252 faixa n\303\243o pode superar a varia\303\247\303\243o entre a 1\302\252 e a 7\302\252 faixa, e o valor da \303\272ltima faixa (59+) n\303\243o pode ultrapassar 6 vezes o valor da primeira (0 a 18 anos). Nosso algoritmo replica com exatid\303\243o essa curva atuarial.\',\n    },\n    {\n      question: \'Por que planos empresariais (MEI/PME) chegam a ser at\303\251 35% mais baratos?\',\n      category: \'Economia & Contrata\303\247\303\243o\',\n      answer:\n        \'Operadoras consideram o risco atuarial dilu\303\255do em grupos corporativos e o custo de inadimpl\303\252ncia menor em contratos vinculados a pessoa jur\303\255dica (CNPJ). Com um MEI aberto h\303\241 pelo menos 6 meses, j\303\241 \303\251 poss\303\255vel contratar a partir de 1 vida (titular) ou 2 vidas (titular + dependente), garantindo a mesma rede credenciada de hospitais e m\303\251dicos por uma mensalidade significativamente inferior.\',\n    },\n    {\n      question: \'O que \303\251 a Coparticipa\303\247\303\243o e quando ela \303\251 recomendada?\',\n      category: \'Modalidade\',\n      answer:\n        \'Na coparticipa\303\247\303\243o, voc\303\252 tem uma redu\303\247\303\243o imediata de 20% a 26% na mensalidade fixa todo m\303\252s. Em troca, quando realiza uma consulta m\303\251dica simples ou exame b\303\241sico, paga uma pequena taxa (geralmente entre R$ 25 e R$ 40 por consulta). Para pessoas e fam\303\255lias com frequ\303\252ncia moderada de utiliza\303\247\303\243o, a economia anual acumulada na mensalidade costuma superar com folga o que \303\251 gasto em coparticipa\303\247\303\265es.\',\n    },\n    {\n      question: \'Quais s\303\243o os prazos m\303\241ximos de car\303\252ncia da ANS?\',\n      category: \'Car\303\252ncias\',\n      answer:\n        \'Pela Lei 9.656/98, os limites legais inultrapass\303\241veis s\303\243o: 24 horas para urg\303\252ncia e emerg\303\252ncia com risco de vida; 30 dias para consultas m\303\251dicas e exames laboratoriais b\303\241sicos; 180 dias para exames especiais, terapias, cirurgias e interna\303\247\303\265es cl\303\255nicas; 300 dias para parto a termo (a partir de 37 semanas); e 24 meses de Cobertura Parcial Tempor\303\241ria (CPT) para doen\303\247as preexistentes declaradas na ades\303\243o.\',\n    },\n    {\n      question: \'Como funciona a Portabilidade de Car\303\252ncias da ANS?\',\n      category: \'Car\303\252ncias & Troca\',\n      answer:\n        \'Se voc\303\252 j\303\241 possui um plano de sa\303\272de h\303\241 pelo menos 2 anos (ou 3 anos caso tenha cumprido CPT) e est\303\241 em dia com as mensalidades, a ANS garante o direito \303\240 portabilidade especial para outro plano de faixa de pre\303\247o compat\303\255vel sem necessidade de cumprir qualquer car\303\252ncia novamente.\',\n    },\n    {\n      question: \'O plano de sa\303\272de \303\251 dedut\303\255vel no Imposto de Renda (IRPF)?\',\n      category: \'Tributa\303\247\303\243o & Benef\303\255cio Fiscal\',\n      answer:\n        \'Sim! Despesas com planos de sa\303\272de para voc\303\252 e seus dependentes legais s\303\243o 100% dedut\303\255veis no Imposto de Renda da Pessoa F\303\255sica (modelo completo), sem qualquer limite de teto anual. Quem est\303\241 na al\303\255quota de 27,5% recupera mais de um quarto de todo o investimento anual em sa\303\272de na restitui\303\247\303\243o ou abatimento do imposto devido.\',\n    },\n  ];\n\n  return (\n    <section id=\"faq\" className=\"py-16 bg-white border-t border-slate-200\">\n      <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        {/* Section Header */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"text-xs font-semibold text-teal-700 uppercase tracking-wider\">\n            Tire Suas D\303\272vidas\n          </div>\n          <h2 className=\"text-2xl sm:text-3xl font-bold font-display text-slate-900 tracking-tight\">\n            Regras da ANS, Car\303\252ncias e Condi\303\247\303\265es de Mercado\n          </h2>\n          <p className=\"text-sm text-slate-500 max-w-xl mx-auto\">\n            Entenda como funciona a precifica\303\247\303\243o, as garantias legais da Lei 9.656/98 e como economizar com seguran\303\247a.\n          </p>\n        </div>\n\n        {/* Accordion List */}\n        <div className=\"space-y-3\">\n          {faqs.map((faq, index) => {\n            const isOpen = openIndex === index;\n            return (\n              <div\n                key={index}\n                className=\"border border-slate-200 rounded-xl overflow-hidden transition-colors\"\n              >\n                <button\n                  onClick={() => setOpenIndex(isOpen ? null : index)}\n                  className=\"w-full p-4 sm:p-5 text-left bg-white hover:bg-slate-50 flex items-center justify-between gap-4 transition-colors\"\n                >\n                  <div className=\"space-y-1\">\n                    <span className=\"text-[10px] font-semibold text-teal-700 uppercase tracking-wider\">\n                      {faq.category}\n                    </span>\n                    <h3 className=\"text-sm font-bold text-slate-900\">{faq.question}</h3>\n                  </div>\n                  <div className=\"w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center shrink-0 text-slate-500\">\n                    {isOpen ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n                  </div>\n                </button>\n\n                {isOpen && (\n                  <div className=\"p-4 sm:p-5 pt-0 bg-white text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-100\">\n                    {faq.answer}\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 105
    num_bytes: 5941
  }
}
