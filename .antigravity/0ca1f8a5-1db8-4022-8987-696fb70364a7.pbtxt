    end_line: 217
    content: "import React, { useState } from \'react\';\nimport {\n  ShieldCheck,\n  ChevronDown,\n  ChevronUp,\n  Building,\n  CheckCircle,\n  HelpCircle,\n  ExternalLink,\n  Sparkles,\n  ArrowRight,\n} from \'lucide-react\';\nimport { CalculatedPlanQuote } from \'../types/healthPlan\';\nimport { getAnsAgeBracketLabel } from \'../utils/pricingEngine\';\n\ninterface PlanCardProps {\n  quote: CalculatedPlanQuote;\n  isSelectedForComparison: boolean;\n  onToggleCompare: (planId: string) => void;\n  onViewDetails: (quote: CalculatedPlanQuote) => void;\n  onRequestProposal: (quote: CalculatedPlanQuote) => void;\n}\n\nexport const PlanCard: React.FC<PlanCardProps> = ({\n  quote,\n  isSelectedForComparison,\n  onToggleCompare,\n  onViewDetails,\n  onRequestProposal,\n}) => {\n  const [showLifeBreakdown, setShowLifeBreakdown] = useState(false);\n\n  return (\n    <div\n      className={`rounded-2xl border transition-all duration-200 bg-white overflow-hidden flex flex-col justify-between ${\n        isSelectedForComparison\n          ? \'border-teal-600 ring-2 ring-teal-500/20 shadow-md\'\n          : \'border-slate-200 hover:border-slate-300 shadow-sm\'\n      }`}\n    >\n      <div>\n        {/* Top bar with operator info and comparison checkbox */}\n        <div className=\"p-5 border-b border-slate-100 flex items-start justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className=\"w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-xs tracking-wider uppercase shadow-sm\"\n              style={{ backgroundColor: quote.operatorColor }}\n            >\n              {quote.operatorLogoText.slice(0, 3)}\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs text-slate-500 font-medium\">{quote.operatorName}</span>\n                <span className=\"text-[10px] text-slate-400 font-mono\">ANS {quote.ansRegister}</span>\n              </div>\n              <h3 className=\"text-base font-bold text-slate-900 font-display leading-snug\">\n                {quote.planName}\n              </h3>\n            </div>\n          </div>\n\n          {/* Comparison checkbox button */}\n          <button\n            onClick={() => onToggleCompare(quote.planId)}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors border flex items-center gap-1.5 whitespace-nowrap ${\n              isSelectedForComparison\n                ? \'bg-teal-600 text-white border-teal-600\'\n                : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n            }`}\n          >\n            <span>{isSelectedForComparison ? \'Selecionado\' : \'Comparar\'}</span>\n          </button>\n        </div>\n\n        {/* Pricing Zone */}\n        <div className=\"p-5 bg-slate-50/50 border-b border-slate-100\">\n          <div className=\"text-[11px] text-slate-500 uppercase tracking-wider font-semibold\">\n            Estimativa Total Mensal\n          </div>\n          <div className=\"flex items-baseline gap-2 mt-1\">\n            <span className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 font-mono tracking-tight tabular-nums\">\n              R$ {quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')}\n            </span>\n            <span className=\"text-xs text-slate-500 font-normal\">/ m\303\252s</span>\n          </div>\n\n          <div className=\"text-[11px] text-slate-500 mt-1 flex flex-wrap items-center justify-between gap-1.5\">\n            <span className=\"font-mono text-slate-400\">\n              Faixa: R$ {quote.priceRangeMin.toLocaleString(\'pt-BR\')} ~ R${\' \'}\n              {quote.priceRangeMax.toLocaleString(\'pt-BR\')}\n            </span>\n            {quote.savingsVsIndividual && (\n              <span className=\"text-emerald-700 font-semibold text-[11px] bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200\">\n                -R$ {quote.savingsVsIndividual.toLocaleString(\'pt-BR\')} vs PF\n              </span>\n            )}\n          </div>\n\n          {/* Toggle breakdown life by life */}\n          <button\n            onClick={() => setShowLifeBreakdown(!showLifeBreakdown)}\n            className=\"mt-3 flex items-center gap-1 text-xs font-semibold text-teal-700 hover:text-teal-800 transition-colors\"\n          >\n            <span>Detalhamento por vida ({quote.perBeneficiaryBreakdown.length} vidas)</span>\n            {showLifeBreakdown ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n          </button>\n\n          {/* Expandable life-by-life table */}\n          {showLifeBreakdown && (\n            <div className=\"mt-3 pt-3 border-t border-slate-200 space-y-2 text-xs\">\n              {quote.perBeneficiaryBreakdown.map((item) => (\n                <div key={item.beneficiaryId} className=\"flex items-center justify-between text-slate-600 py-1\">\n                  <div className=\"truncate pr-2\">\n                    <span className=\"font-medium text-slate-900\">{item.beneficiaryName}</span>{\' \'}\n                    <span className=\"text-slate-400\">({item.age} anos \302\267 {getAnsAgeBracketLabel(item.ageBracket)})</span>\n                  </div>\n                  <span className=\"font-mono font-semibold text-slate-900 shrink-0\">\n                    R$ {item.calculatedPrice.toLocaleString(\'pt-BR\')}\n                  </span>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* Feature badges and hospitals */}\n        <div className=\"p-5 space-y-4 text-xs\">\n          {/* ANS IDSS score & Accommodation */}\n          <div className=\"grid grid-cols-2 gap-2 text-slate-600\">\n            <div className=\"p-2.5 rounded-lg bg-slate-50 border border-slate-100\">\n              <span className=\"text-[10px] text-slate-400 block uppercase font-medium\">\303\215ndice ANS IDSS</span>\n              <span className=\"font-bold text-slate-800 flex items-center gap-1\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-teal-600\" />\n                {quote.ansScore.toFixed(2)} / 1.00\n              </span>\n            </div>\n\n            <div className=\"p-2.5 rounded-lg bg-slate-50 border border-slate-100\">\n              <span className=\"text-[10px] text-slate-400 block uppercase font-medium\">Acomoda\303\247\303\243o</span>\n              <span className=\"font-bold text-slate-800 capitalize\">\n                {quote.accommodation}\n              </span>\n            </div>\n          </div>\n\n          {/* Key highlights */}\n          <div>\n            <span className=\"text-[11px] font-semibold text-slate-700 uppercase tracking-wide block mb-2\">\n              Diferenciais do Plano\n            </span>\n            <ul className=\"space-y-1.5 text-slate-600\">\n              {quote.keyHighlights.slice(0, 3).map((hl, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span className=\"leading-snug\">{hl}</span>\n                </li>\n              ))}\n              {quote.reimbursementConsultation > 0 ? (\n                <li className=\"flex items-start gap-2 font-medium text-slate-800\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span>Reembolso m\303\251dico: R$ {quote.reimbursementConsultation} por consulta</span>\n                </li>\n              ) : (\n                <li className=\"flex items-start gap-2 text-slate-500\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5\" />\n                  <span>Atendimento sem reembolso (Rede credenciada direta)</span>\n                </li>\n              )}\n            </ul>\n          </div>\n\n          {/* Reference Hospitals preview */}\n          {quote.hospitals.length > 0 && (\n            <div>\n              <span className=\"text-[11px] font-semibold text-slate-700 uppercase tracking-wide block mb-1.5\">\n                Rede Hospitalar em Destaque\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {quote.hospitals.slice(0, 3).map((h, i) => (\n                  <span\n                    key={i}\n                    className=\"text-[11px] bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200/80 truncate max-w-[200px]\"\n                  >\n                    {h}\n                  </span>\n                ))}\n                {quote.hospitals.length > 3 && (\n                  <span className=\"text-[10px] text-slate-400 self-center\">\n                    +{quote.hospitals.length - 3} hospitais\n                  </span>\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Card Actions */}\n      <div className=\"p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-2\">\n        <button\n          onClick={() => onViewDetails(quote)}\n          className=\"px-3 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors\"\n        >\n          Car\303\252ncias & Regras\n        </button>\n\n        <button\n          onClick={() => onRequestProposal(quote)}\n          className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\"\n        >\n          <span>Receber Proposta</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport {\n  ShieldCheck,\n  ChevronDown,\n  ChevronUp,\n  Building,\n  CheckCircle,\n  HelpCircle,\n  ExternalLink,\n  Sparkles,\n  ArrowRight,\n} from \'lucide-react\';\nimport { CalculatedPlanQuote } from \'../types/healthPlan\';\nimport { getAnsAgeBracketLabel } from \'../utils/pricingEngine\';\n\ninterface PlanCardProps {\n  quote: CalculatedPlanQuote;\n  isSelectedForComparison: boolean;\n  onToggleCompare: (planId: string) => void;\n  onViewDetails: (quote: CalculatedPlanQuote) => void;\n  onRequestProposal: (quote: CalculatedPlanQuote) => void;\n}\n\nexport const PlanCard: React.FC<PlanCardProps> = ({\n  quote,\n  isSelectedForComparison,\n  onToggleCompare,\n  onViewDetails,\n  onRequestProposal,\n}) => {\n  const [showLifeBreakdown, setShowLifeBreakdown] = useState(false);\n\n  return (\n    <div\n      className={`rounded-2xl border transition-all duration-200 bg-white overflow-hidden flex flex-col justify-between ${\n        isSelectedForComparison\n          ? \'border-teal-600 ring-2 ring-teal-500/20 shadow-md\'\n          : \'border-slate-200 hover:border-slate-300 shadow-sm\'\n      }`}\n    >\n      <div>\n        {/* Top bar with operator info and comparison checkbox */}\n        <div className=\"p-5 border-b border-slate-100 flex items-start justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div\n              className=\"w-10 h-10 rounded-xl flex items-center justify-center font-bold text-white text-xs tracking-wider uppercase shadow-sm\"\n              style={{ backgroundColor: quote.operatorColor }}\n            >\n              {quote.operatorLogoText.slice(0, 3)}\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs text-slate-500 font-medium\">{quote.operatorName}</span>\n                <span className=\"text-[10px] text-slate-400 font-mono\">ANS {quote.ansRegister}</span>\n              </div>\n              <h3 className=\"text-base font-bold text-slate-900 font-display leading-snug\">\n                {quote.planName}\n              </h3>\n            </div>\n          </div>\n\n          {/* Comparison checkbox button */}\n          <button\n            onClick={() => onToggleCompare(quote.planId)}\n            className={`px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors border flex items-center gap-1.5 whitespace-nowrap ${\n              isSelectedForComparison\n                ? \'bg-teal-600 text-white border-teal-600\'\n                : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n            }`}\n          >\n            <span>{isSelectedForComparison ? \'Selecionado\' : \'Comparar\'}</span>\n          </button>\n        </div>\n\n        {/* Pricing Zone */}\n        <div className=\"p-5 bg-slate-50/50 border-b border-slate-100\">\n          <div className=\"text-[11px] text-slate-500 uppercase tracking-wider font-semibold\">\n            Estimativa Total Mensal\n          </div>\n          <div className=\"flex items-baseline gap-2 mt-1\">\n            <span className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 font-mono tracking-tight tabular-nums\">\n              R$ {quote.totalMonthlyPrice.toLocaleString(\'pt-BR\')}\n            </span>\n            <span className=\"text-xs text-slate-500 font-normal\">/ m\303\252s</span>\n          </div>\n\n          <div className=\"text-[11px] text-slate-500 mt-1 flex flex-wrap items-center justify-between gap-1.5\">\n            <span className=\"font-mono text-slate-400\">\n              Faixa: R$ {quote.priceRangeMin.toLocaleString(\'pt-BR\')} ~ R${\' \'}\n              {quote.priceRangeMax.toLocaleString(\'pt-BR\')}\n            </span>\n            {quote.savingsVsIndividual && (\n              <span className=\"text-emerald-700 font-semibold text-[11px] bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200\">\n                -R$ {quote.savingsVsIndividual.toLocaleString(\'pt-BR\')} vs PF\n              </span>\n            )}\n          </div>\n\n          {/* Toggle breakdown life by life */}\n          <button\n            onClick={() => setShowLifeBreakdown(!showLifeBreakdown)}\n            className=\"mt-3 flex items-center gap-1 text-xs font-semibold text-teal-700 hover:text-teal-800 transition-colors\"\n          >\n            <span>Detalhamento por vida ({quote.perBeneficiaryBreakdown.length} vidas)</span>\n            {showLifeBreakdown ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n          </button>\n\n          {/* Expandable life-by-life table */}\n          {showLifeBreakdown && (\n            <div className=\"mt-3 pt-3 border-t border-slate-200 space-y-2 text-xs\">\n              {quote.perBeneficiaryBreakdown.map((item) => (\n                <div key={item.beneficiaryId} className=\"flex items-center justify-between text-slate-600 py-1\">\n                  <div className=\"truncate pr-2\">\n                    <span className=\"font-medium text-slate-900\">{item.beneficiaryName}</span>{\' \'}\n                    <span className=\"text-slate-400\">({item.age} anos \302\267 {getAnsAgeBracketLabel(item.ageBracket)})</span>\n                  </div>\n                  <span className=\"font-mono font-semibold text-slate-900 shrink-0\">\n                    R$ {item.calculatedPrice.toLocaleString(\'pt-BR\')}\n                  </span>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* Feature badges and hospitals */}\n        <div className=\"p-5 space-y-4 text-xs\">\n          {/* ANS IDSS score & Accommodation */}\n          <div className=\"grid grid-cols-2 gap-2 text-slate-600\">\n            <div className=\"p-2.5 rounded-lg bg-slate-50 border border-slate-100\">\n              <span className=\"text-[10px] text-slate-400 block uppercase font-medium\">\303\215ndice ANS IDSS</span>\n              <span className=\"font-bold text-slate-800 flex items-center gap-1\">\n                <ShieldCheck className=\"w-3.5 h-3.5 text-teal-600\" />\n                {quote.ansScore.toFixed(2)} / 1.00\n              </span>\n            </div>\n\n            <div className=\"p-2.5 rounded-lg bg-slate-50 border border-slate-100\">\n              <span className=\"text-[10px] text-slate-400 block uppercase font-medium\">Acomoda\303\247\303\243o</span>\n              <span className=\"font-bold text-slate-800 capitalize\">\n                {quote.accommodation}\n              </span>\n            </div>\n          </div>\n\n          {/* Key highlights */}\n          <div>\n            <span className=\"text-[11px] font-semibold text-slate-700 uppercase tracking-wide block mb-2\">\n              Diferenciais do Plano\n            </span>\n            <ul className=\"space-y-1.5 text-slate-600\">\n              {quote.keyHighlights.slice(0, 3).map((hl, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span className=\"leading-snug\">{hl}</span>\n                </li>\n              ))}\n              {quote.reimbursementConsultation > 0 ? (\n                <li className=\"flex items-start gap-2 font-medium text-slate-800\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span>Reembolso m\303\251dico: R$ {quote.reimbursementConsultation} por consulta</span>\n                </li>\n              ) : (\n                <li className=\"flex items-start gap-2 text-slate-500\">\n                  <CheckCircle className=\"w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5\" />\n                  <span>Atendimento sem reembolso (Rede credenciada direta)</span>\n                </li>\n              )}\n            </ul>\n          </div>\n\n          {/* Reference Hospitals preview */}\n          {quote.hospitals.length > 0 && (\n            <div>\n              <span className=\"text-[11px] font-semibold text-slate-700 uppercase tracking-wide block mb-1.5\">\n                Rede Hospitalar em Destaque\n              </span>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {quote.hospitals.slice(0, 3).map((h, i) => (\n                  <span\n                    key={i}\n                    className=\"text-[11px] bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200/80 truncate max-w-[200px]\"\n                  >\n                    {h}\n                  </span>\n                ))}\n                {quote.hospitals.length > 3 && (\n                  <span className=\"text-[10px] text-slate-400 self-center\">\n                    +{quote.hospitals.length - 3} hospitais\n                  </span>\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Card Actions */}\n      <div className=\"p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-2\">\n        <button\n          onClick={() => onViewDetails(quote)}\n          className=\"px-3 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors\"\n        >\n          Car\303\252ncias & Regras\n        </button>\n\n        <button\n          onClick={() => onRequestProposal(quote)}\n          className=\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap\"\n        >\n          <span>Receber Proposta</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 218
